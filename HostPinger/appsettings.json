{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Every ping round inserts one row per host, and EF logs each executed command at
      // Information. Left alone that is the interval divided into a host's worth of journal
      // lines a minute, forever, saying nothing that is not already in the database. Only the
      // command category is turned down, so migration and connection problems still surface.
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  // ASP.NET Core's own host filtering is left off: it matches listed names only, and a service
  // reached by whatever address and name its network gives it has no list to write here.
  // HostNameFilter decides instead; further names go in Security:AllowedHostNames.
  "AllowedHosts": "*"
}
