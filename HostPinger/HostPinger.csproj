<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\HostPinger.Core\HostPinger.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the tests reach the small internal helpers under Security/, such as the check that
         keeps the unlock forms from redirecting off the site. -->
    <InternalsVisibleTo Include="HostPinger.Test" />
  </ItemGroup>

  <ItemGroup>
    <!-- Data/ is the local development database and settings overlay. Without this it matches the
         Web SDK's default **/*.json content glob and ships in publish output — and so in the MSI. -->
    <Content Remove="Data\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The About page renders the marked section of the README rather than restating it, so the
         file has to travel with the assembly instead of staying in the checkout. Compiling it in
         rather than copying it beside the executable means it reaches the RPM and the MSI without
         either packaging step knowing about it. -->
    <EmbeddedResource Include="..\README.md" LogicalName="README.md" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Renders the README section above onto the About page. -->
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both are no-ops off their own platform, so the same build hosts itself correctly as a
         Windows service and as a systemd unit. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keeps Entity Framework and SQLite out of this project: a use of anything BannedSymbols.txt
         lists is reported as RS0030 in the editor as it is typed, and fails the build. The file
         says what it covers and what it leaves to WebProjectTests and to the package list below. -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every package this project may reference; the target below fails restore and build on any
         other. BannedSymbols.txt can only ban what the compilation already contains, so a new data
         package (System.Data.SQLite, sqlite-net-pcl, Dapper and the like) would arrive with nothing
         banning its types. GitVersion.MsBuild is here because Directory.Build.props adds it to
         every project. -->
    <PermittedPackageReference Include="GitVersion.MsBuild" />
    <PermittedPackageReference Include="Markdig" />
    <PermittedPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" />
    <PermittedPackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
    <PermittedPackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>

  <!-- Ahead of restore as well as build, so a package that is not on the list never reaches the
       project. It also runs before the SDK adds packages of its own, such as the trimmer's when
       trimming is on, so those are not held to the list.

       The two other ways a library arrives are refused here too: a DLL referenced by its path,
       and a reference to a project other than Core. Neither would pass through the list above,
       and either could bring a data library whose types the ban list knows nothing of.
       WebProjectTests checks the compiled assembly's references as well, which also catches a
       library reached through Core's own references. -->
  <Target Name="RejectUnpermittedPackageReferences" BeforeTargets="CollectPackageReferences">
    <ItemGroup>
      <_UnpermittedPackageReference Include="@(PackageReference)" Exclude="@(PermittedPackageReference)" />
      <_ReferenceByPath Include="@(Reference)" Condition="'%(Reference.HintPath)' != ''" />
      <_OtherProjectReference Include="@(ProjectReference)" Condition="'%(ProjectReference.Filename)' != 'HostPinger.Core'" />
    </ItemGroup>
    <Error Condition="'@(_UnpermittedPackageReference)' != ''"
           Text="HostPinger.csproj references a package that is not on its PermittedPackageReference list: @(_UnpermittedPackageReference->'%(Identity)', ', '). A package that reads or writes the database belongs in HostPinger.Core, behind a method the pages call; any other package, add to the list." />
    <Error Condition="'@(_ReferenceByPath)' != ''"
           Text="HostPinger.csproj references an assembly by its path: @(_ReferenceByPath->'%(Identity)', ', '). Reference it as a package on the PermittedPackageReference list instead, or, if it reads or writes the database, from HostPinger.Core." />
    <Error Condition="'@(_OtherProjectReference)' != ''"
           Text="HostPinger.csproj references a project other than HostPinger.Core: @(_OtherProjectReference->'%(Identity)', ', '). Database code belongs in HostPinger.Core, behind a method the pages call." />
  </Target>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- RS0030 is a use of a banned symbol, which as the analyzer's default warning would build.
         CS9057 and CS8032 are the compiler failing to load an analyzer, CS9057 because it was
         built for a newer compiler than the one running. Either way the ban stops being checked
         while the build still passes, and the Fedora job builds with the distribution's SDK,
         which can be a band behind the analyzer Dependabot moves this to. -->
    <WarningsAsErrors>$(WarningsAsErrors);RS0030;CS9057;CS8032</WarningsAsErrors>
  </PropertyGroup>

</Project>
