@page "/"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using HostPinger.Core.Options
@using HostPinger.Security
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Options
@inject IDbContextFactory<HostPingerDbContext> DbFactory
@inject IOptionsMonitor<PingerOptions> PingerOptions
@inject NavigationManager Navigation
@inject PasswordGate Gate
@inject LockPrompt Prompt
@implements IDisposable

@* The landing page, so the bare product name rather than "HostPinger - Hosts". *@
<PageTitle>HostPinger</PageTitle>

<h1>Hosts</h1>

<div class="d-flex align-items-center justify-content-between gap-3 mb-3">
    <span class="text-muted">
        @if (_rows.Count == 0)
        {
            @(_isUnlocked ? "No hosts yet — add one to start monitoring." : "No hosts yet.")
        }
        else
        {
            @("Click a host to open its ping graph.")
        }
        @if (!_isUnlocked)
        {
            @* A button rather than a link: the overlay belongs to the layout, and this asks for it. *@
            <text> <button type="button" class="btn btn-link btn-sm p-0 align-baseline"
                          @onclick="() => Prompt.Request()">Unlock</button> to add, edit or pause hosts.</text>
        }
    </span>
    @* flex-shrink-0 so a narrow window wraps the hint rather than squashing the button. *@
    @if (_isUnlocked)
    {
        <button class="btn btn-primary btn-sm flex-shrink-0" @onclick="BeginAdd">Add host</button>
    }
</div>

@if (_rows.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-hover align-middle host-table">
            <colgroup>
                <col class="name" />
                <col class="address" />
                <col class="status" />
                <col class="last-ping" />
                <col class="last-downtime" />
                <col class="enabled" />
                <col class="actions" />
            </colgroup>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Address</th>
                    <th>Status</th>
                    <th>Last ping</th>
                    <th>Last downtime</th>
                    <th><span class="visually-hidden">Enabled</span></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    @*
                        Keyed on the generation as well as the host so that a refused pause can put
                        the switch back. The browser has already moved it, and the value it is
                        bound to has not changed, so the diff has nothing to say about it and the
                        DOM keeps the movement; a new key builds the row again instead.
                    *@
                    <tr class="host-row" @key="(row.Host.Id, _rowGeneration)" @onclick="() => OpenGraph(row.Host.Id)">
                        <td title="@row.Host.Name">@row.Host.Name</td>
                        <td title="@row.Host.Address"><code>@row.Host.Address</code></td>
                        <td>
                            @if (row.Status is HostStatus.Paused)
                            {
                                <span class="badge text-bg-secondary">Paused</span>
                            }
                            else if (row.Status is HostStatus.Waiting)
                            {
                                <span class="badge bg-body-secondary text-body-secondary">Waiting…</span>
                            }
                            else if (row.Status is HostStatus.Retrying)
                            {
                                @*
                                    How far along the retries are is a tooltip rather than part of
                                    the badge: the count changes every round, and a badge that
                                    changes width with it would drag the column about.
                                *@
                                <span class="badge text-bg-warning"
                                      title="@($"{row.MissedPings} of {_missesToDown} pings missed")">Retrying</span>
                            }
                            else if (row.Status is HostStatus.Down)
                            {
                                <span class="badge text-bg-danger">Down</span>
                            }
                            else
                            {
                                <span class="badge text-bg-success">Up</span>
                            }
                        </td>
                        <td>
                            @if (row.Last is { } last)
                            {
                                <span class="ping-value">@(last.RoundtripMs is int ms ? $"{ms} ms" : "no reply")</span>
                                <small class="text-muted ms-2">@RelativeTime(last.TimestampUtc)</small>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (row.LastDowntime is { } downtime)
                            {
                                <span class="ping-value">@downtime.StartedUtc.ToLocalTime().ToString("g")</span>
                                <small class="ms-2 @(downtime.IsOngoing ? "text-danger" : "text-muted")">
                                    @Downtime.FormatDuration(downtime.DurationAt(DateTime.UtcNow))@(downtime.IsOngoing ? " and counting" : "")
                                </small>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td @onclick:stopPropagation>
                            @* Shown either way, so a locked reader can still see what is paused. *@
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       disabled="@(!_isUnlocked)"
                                       title="@PauseTitle(row.Host.IsEnabled)"
                                       checked="@row.Host.IsEnabled"
                                       @onchange="e => SetEnabledAsync(row.Host.Id, (bool)e.Value!)" />
                            </div>
                        </td>
                        <td class="actions">
                            @if (_isUnlocked)
                            {
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => BeginEdit(row.Host)" @onclick:stopPropagation>Edit</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_isFormOpen)
{
    @* Bootstrap's modal markup, driven from here: the app does not load Bootstrap's JavaScript. *@
    <div class="modal d-block" tabindex="-1" aria-modal="true" role="dialog"
         @onkeydown="OnFormKeyDown" @onclick="OnOverlayClick" @onmousedown="() => _pressedInsideForm = false">
        <div class="modal-dialog modal-dialog-centered host-form-dialog">
            @*
                Cancel on a click outside the dialog. The content box stops both events rather than
                the dialog box, because modal-dialog-centered stretches that one to the full height
                of the overlay — a click above or below the form has to reach the overlay to count
                as a click away.
            *@
            <div class="modal-content" @onclick:stopPropagation
                 @onmousedown="() => _pressedInsideForm = true" @onmousedown:stopPropagation>
                <EditForm Model="_form" OnValidSubmit="SaveAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">@(_form.Id is null ? "Add host" : "Edit host")</h5>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CloseForm"></button>
                    </div>
                    <div class="modal-body">
                        @if (_error is not null)
                        {
                            <div class="alert alert-danger py-2">@_error</div>
                        }
                        <div class="row g-2">
                            <div class="col-sm-4">
                                <label class="form-label" for="host-name">Name</label>
                                <InputText id="host-name" class="form-control" @bind-Value="_form.Name" @ref="_nameInput" />
                                <ValidationMessage For="() => _form.Name" />
                            </div>
                            @* Address takes whatever the other two leave rather than a share of its own. *@
                            <div class="col-sm">
                                <label class="form-label" for="host-address">Address</label>
                                <InputText id="host-address" class="form-control" @bind-Value="_form.Address"
                                           placeholder="e.g. 192.168.1.1 or example.com" />
                                <ValidationMessage For="() => _form.Address" />
                            </div>
                            @* The same switch the table shows, under its own label like the fields beside it. *@
                            <div class="col-sm-auto">
                                <label class="form-label" for="host-enabled">Enabled</label>
                                <div class="form-check form-switch host-enabled-switch">
                                    <InputCheckbox id="host-enabled" class="form-check-input" role="switch" @bind-Value="_form.IsEnabled" />
                                </div>
                            </div>
                        </div>
                    </div>
                    @*
                        Confirming a delete takes over the whole footer rather than sitting next to
                        the usual buttons, so there is only ever one Cancel to read.
                    *@
                    <div class="modal-footer justify-content-between">
                        @if (_isDeletePending && _form.Id is int deleteId)
                        {
                            <span class="text-danger">Delete this host and its ping history?</span>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => _isDeletePending = false">Cancel</button>
                                <button type="button" class="btn btn-danger btn-sm" @onclick="() => DeleteAsync(deleteId)">Confirm delete</button>
                            </div>
                        }
                        else
                        {
                            <div>
                                @if (_form.Id is not null)
                                {
                                    <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => _isDeletePending = true">Delete</button>
                                }
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CloseForm">Cancel</button>
                                <button type="submit" class="btn btn-primary btn-sm">@(_form.Id is null ? "Add host" : "Save changes")</button>
                            </div>
                        }
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private List<HostSummary> _rows = [];

    // How many missed pings make a host down, read with each load rather than once so a retry
    // count changed on the Configuration page reaches the badges on the next refresh.
    private int _missesToDown = 1;

    // Whether this browser may change anything, re-read with each load like the setting above, so
    // that a password set or removed elsewhere reaches the controls on the next refresh.
    private bool _isUnlocked;

    // Bumped to have the rows rebuilt rather than diffed; see the key on the row.
    private int _rowGeneration;

    private HostForm _form = new();
    private bool _isFormOpen;
    private InputText? _nameInput;
    private bool _focusNameInput;
    private bool _pressedInsideForm;
    private bool _isDeletePending;
    private string? _error;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _ = AutoRefreshAsync();
    }

    // Focusing the first field also puts the keyboard inside the dialog, which is what lets the
    // Escape key reach OnFormKeyDown.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusNameInput && _nameInput?.Element is { } element)
        {
            _focusNameInput = false;
            await element.FocusAsync();
        }
    }

    private async Task AutoRefreshAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task LoadAsync()
    {
        var retryAttempts = PingerOptions.CurrentValue.RetryAttempts;
        _missesToDown = Math.Max(0, retryAttempts) + 1;
        _isUnlocked = await IsUnlockedAsync();
        await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
        _rows = await HostSummary.LoadAsync(db, retryAttempts, _cts.Token);
    }

    /// <summary>
    /// Whether this browser may change hosts. Asked again inside every handler below rather than
    /// trusted from the last render: hiding a button is a courtesy to the reader, and this is the
    /// answer that decides whether anything is written.
    /// </summary>
    private async Task<bool> IsUnlockedAsync()
    {
        var user = AuthenticationState is null ? null : (await AuthenticationState).User;
        return Gate.IsUnlocked(user);
    }

    private async Task SaveAsync()
    {
        if (!await IsUnlockedAsync())
        {
            _error = "HostPinger is locked. Unlock it to change hosts.";
            return;
        }

        var name = _form.Name.Trim();
        var address = _form.Address.Trim();
        await using var db = await DbFactory.CreateDbContextAsync();
        try
        {
            if (_form.Id is int id)
            {
                var host = await db.Hosts.FindAsync(id);
                if (host is null)
                {
                    _error = "This host no longer exists.";
                    return;
                }

                host.Name = name;
                host.Address = address;
                host.IsEnabled = _form.IsEnabled;
            }
            else
            {
                db.Hosts.Add(new MonitoredHost
                {
                    Name = name,
                    Address = address,
                    IsEnabled = _form.IsEnabled,
                    CreatedUtc = DateTime.UtcNow,
                });
            }

            await db.SaveChangesAsync();
        }
        catch (DbUpdateException)
        {
            _error = $"A host with address \"{address}\" already exists.";
            return;
        }

        CloseForm();
        await LoadAsync();
    }

    private async Task SetEnabledAsync(int id, bool isEnabled)
    {
        if (!await IsUnlockedAsync())
        {
            // The switch has already moved in the browser, so rebuild the rows to put it back.
            _rowGeneration++;
            await LoadAsync();
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        await db.Hosts.Where(h => h.Id == id)
            .ExecuteUpdateAsync(s => s.SetProperty(h => h.IsEnabled, isEnabled));
        if (_form.Id == id)
        {
            _form.IsEnabled = isEnabled;
        }

        await LoadAsync();
    }

    private async Task DeleteAsync(int id)
    {
        if (!await IsUnlockedAsync())
        {
            _isDeletePending = false;
            _error = "HostPinger is locked. Unlock it to change hosts.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        await db.Hosts.Where(h => h.Id == id).ExecuteDeleteAsync();
        CloseForm();
        await LoadAsync();
    }

    private void BeginAdd() => OpenForm(new HostForm());

    private void BeginEdit(MonitoredHost host) => OpenForm(new HostForm
    {
        Id = host.Id,
        Name = host.Name,
        Address = host.Address,
        IsEnabled = host.IsEnabled,
    });

    private void OpenForm(HostForm form)
    {
        _form = form;
        _error = null;
        _pressedInsideForm = false;
        _isDeletePending = false;
        _isFormOpen = true;
        _focusNameInput = true;
    }

    private void CloseForm()
    {
        _form = new HostForm();
        _error = null;
        _isDeletePending = false;
        _isFormOpen = false;
    }

    private void OnFormKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseForm();
        }
    }

    /// <summary>
    /// Cancels on a click away. Dragging a text selection out of a field also raises a click on
    /// the overlay, so a press that started inside the dialog is not one — it would throw away
    /// what the user was in the middle of selecting.
    /// </summary>
    private void OnOverlayClick()
    {
        if (!_pressedInsideForm)
        {
            CloseForm();
        }
    }

    private void OpenGraph(int hostId) => Navigation.NavigateTo($"graph/{hostId}");

    private string PauseTitle(bool isEnabled) => _isUnlocked
        ? isEnabled ? "Pause monitoring" : "Resume monitoring"
        : "Unlock to pause or resume monitoring";

    private static string RelativeTime(DateTime timestampUtc)
    {
        var age = DateTime.UtcNow - timestampUtc;
        return age switch
        {
            { TotalSeconds: < 5 } => "just now",
            { TotalMinutes: < 1 } => $"{(int)age.TotalSeconds}s ago",
            { TotalHours: < 1 } => $"{(int)age.TotalMinutes}m ago",
            { TotalDays: < 1 } => $"{(int)age.TotalHours}h ago",
            _ => timestampUtc.ToLocalTime().ToString("g"),
        };
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    private sealed class HostForm
    {
        public int? Id { get; set; }

        [Required(ErrorMessage = "Name is required.")]
        [StringLength(100)]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Address is required.")]
        [StringLength(253)]
        public string Address { get; set; } = string.Empty;

        public bool IsEnabled { get; set; } = true;
    }
}
