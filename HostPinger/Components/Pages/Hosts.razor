@page "/"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using HostPinger.Core.Services
@using HostPinger.Security
@using Microsoft.AspNetCore.Components.Authorization
@inject HostStore Store
@inject HostSummaryCache Summaries
@inject NavigationManager Navigation
@inject PasswordGate Gate
@inject LockPrompt Prompt
@implements IDisposable

@* The landing page, so the bare product name rather than "HostPinger - Hosts". *@
<PageTitle>HostPinger</PageTitle>

<h1>Hosts</h1>

<div class="d-flex align-items-center justify-content-between gap-3 mb-3">
    <span class="text-muted">
        @if (_rows.Count == 0)
        {
            @(_isUnlocked ? "No hosts yet — add one to start monitoring." : "No hosts yet.")
        }
        else
        {
            @("Click a host to open its ping graph, or its last downtime to open the graph on that outage.")
        }
        @if (!_isUnlocked)
        {
            @* A button rather than a link: the overlay belongs to the layout, and this asks for it. *@
            <text> <button type="button" class="btn btn-link btn-sm p-0 align-baseline"
                          @onclick="() => Prompt.Request()">Unlock</button> to add, edit or pause hosts.</text>
        }
    </span>
    @* flex-shrink-0 so a narrow window wraps the hint rather than squashing the button. *@
    @if (_isUnlocked)
    {
        <button class="btn btn-primary btn-sm flex-shrink-0" @onclick="BeginAdd">Add host</button>
    }
</div>

@if (_switchError is not null)
{
    <div class="alert alert-danger alert-dismissible py-2 switch-error" role="alert">
        @_switchError
        <button type="button" class="btn-close py-2" aria-label="Close" @onclick="() => _switchError = null"></button>
    </div>
}

@if (_rows.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-hover align-middle host-table">
            <colgroup>
                <col class="name" />
                <col class="address" />
                <col class="status" />
                <col class="last-ping" />
                <col class="last-downtime" />
                <col class="enabled" />
                <col class="actions" />
            </colgroup>
            <thead>
                @*
                    Every column that says something about a host is sortable; the switch and the
                    Edit button are not columns anyone reads down. Paused hosts are reachable
                    through Status, which is where a host that is not being pinged already shows up.
                *@
                <tr>
                    @SortHeader(HostSortColumn.Name, "Name")
                    @SortHeader(HostSortColumn.Address, "Address")
                    @SortHeader(HostSortColumn.Status, "Status")
                    @SortHeader(HostSortColumn.LastPing, "Last ping")
                    @SortHeader(HostSortColumn.LastDowntime, "Last downtime")
                    <th><span class="visually-hidden">Enabled</span></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    @*
                        Keyed on the generation as well as the host so that a refused pause can put
                        the switch back. The browser has already moved it, and the value it is
                        bound to has not changed, so the diff has nothing to say about it and the
                        DOM keeps the movement; a new key builds the row again instead.
                    *@
                    <tr class="host-row" @key="(row.Host.Id, _rowGeneration)" @onclick="() => OpenGraph(row.Host.Id)">
                        <td title="@row.Host.Name">@row.Host.Name</td>
                        <td title="@row.Host.Address"><code>@row.Host.Address</code></td>
                        <td>
                            @if (row.Status is HostStatus.Paused)
                            {
                                <span class="badge text-bg-secondary">Paused</span>
                            }
                            else if (row.Status is HostStatus.Waiting)
                            {
                                <span class="badge bg-body-secondary text-body-secondary">Waiting…</span>
                            }
                            else if (row.Status is HostStatus.Retrying)
                            {
                                @*
                                    How far along the retries are is a tooltip rather than part of
                                    the badge: the count changes every round, and a badge that
                                    changes width with it would drag the column about.
                                *@
                                <span class="badge text-bg-warning"
                                      title="@($"{row.MissedPings} of {_missesToDown} pings missed")">Retrying</span>
                            }
                            else if (row.Status is HostStatus.Down)
                            {
                                <span class="badge text-bg-danger">Down</span>
                            }
                            else
                            {
                                <span class="badge text-bg-success">Up</span>
                            }
                        </td>
                        <td>
                            @if (row.Last is { } last)
                            {
                                <span class="ping-value">@(last.RoundtripMs is int ms ? $"{ms} ms" : "no reply")</span>
                                <small class="text-muted ms-2">@RelativeTime(last.TimestampUtc)</small>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        @*
                            The one cell that goes somewhere of its own, so it swallows the click
                            rather than letting the row's handler take it: an outage is worth
                            arriving at the graph already looking at, and the row cannot know which
                            one was meant. A cell with no outage in it has nothing of its own to
                            open and falls back to the row's plain graph.
                        *@
                        <td class="last-downtime" title="@DowntimeTitle(row)"
                            @onclick="() => OpenDowntime(row)" @onclick:stopPropagation>
                            @if (row.LastDowntime is { } downtime)
                            {
                                <span class="ping-value">@downtime.StartedUtc.ToLocalTime().ToString("g")</span>
                                <small class="ms-2 @(downtime.IsOngoing ? "text-danger" : "text-muted")">
                                    @Downtime.FormatDuration(downtime.DurationAt(DateTime.UtcNow))@(downtime.IsOngoing ? " and counting" : "")
                                </small>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td @onclick:stopPropagation>
                            @* Shown either way, so a locked reader can still see what is paused. *@
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch"
                                       disabled="@(!_isUnlocked)"
                                       title="@PauseTitle(row.Host.IsEnabled)"
                                       checked="@row.Host.IsEnabled"
                                       @onchange="e => SetEnabledAsync(row.Host.Id, (bool)e.Value!)" />
                            </div>
                        </td>
                        <td class="actions">
                            @if (_isUnlocked)
                            {
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => BeginEdit(row.Host)" @onclick:stopPropagation>Edit</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (_isFormOpen)
{
    @* Bootstrap's modal markup, driven from here: the app does not load Bootstrap's JavaScript. *@
    <div class="modal d-block" tabindex="-1" aria-modal="true" role="dialog"
         @onkeydown="OnFormKeyDown" @onclick="OnOverlayClick" @onmousedown="() => _pressedInsideForm = false">
        <div class="modal-dialog modal-dialog-centered host-form-dialog">
            @*
                Cancel on a click outside the dialog. The content box stops both events rather than
                the dialog box, because modal-dialog-centered stretches that one to the full height
                of the overlay — a click above or below the form has to reach the overlay to count
                as a click away.
            *@
            <div class="modal-content" @onclick:stopPropagation
                 @onmousedown="() => _pressedInsideForm = true" @onmousedown:stopPropagation>
                <EditForm Model="_form" OnValidSubmit="SaveAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">@(_form.Id is null ? "Add host" : "Edit host")</h5>
                        <button type="button" class="btn-close" aria-label="Close" disabled="@_isChanging" @onclick="CloseForm"></button>
                    </div>
                    <div class="modal-body">
                        @if (_error is not null)
                        {
                            <div class="alert alert-danger py-2">@_error</div>
                        }
                        <div class="row g-2">
                            <div class="col-sm-4">
                                <label class="form-label" for="host-name">Name</label>
                                <InputText id="host-name" class="form-control" @bind-Value="_form.Name" @ref="_nameInput" />
                                <ValidationMessage For="() => _form.Name" />
                            </div>
                            @* Address takes whatever the other two leave rather than a share of its own. *@
                            <div class="col-sm">
                                <label class="form-label" for="host-address">Address</label>
                                <InputText id="host-address" class="form-control" @bind-Value="_form.Address"
                                           placeholder="e.g. 192.168.1.1 or example.com" />
                                <ValidationMessage For="() => _form.Address" />
                            </div>
                            @* The same switch the table shows, under its own label like the fields beside it. *@
                            <div class="col-sm-auto">
                                <label class="form-label" for="host-enabled">Enabled</label>
                                <div class="form-check form-switch host-enabled-switch">
                                    <InputCheckbox id="host-enabled" class="form-check-input" role="switch" @bind-Value="_form.IsEnabled" />
                                </div>
                            </div>
                        </div>
                    </div>
                    @*
                        Confirming a delete takes over the whole footer rather than sitting next to
                        the usual buttons, so there is only ever one Cancel to read.
                    *@
                    <div class="modal-footer justify-content-between">
                        @if (_isDeletePending && _form.Id is int deleteId)
                        {
                            <span class="text-danger">Delete this host and its ping history?</span>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_isChanging" @onclick="() => _isDeletePending = false">Cancel</button>
                                @* A host with months of history takes seconds to delete; the store does it off this
                                   page's circuit, so the button can say so meanwhile. *@
                                <button type="button" class="btn btn-danger btn-sm" disabled="@_isChanging" @onclick="() => DeleteAsync(deleteId)">@(_isChanging ? "Deleting…" : "Confirm delete")</button>
                            </div>
                        }
                        else
                        {
                            <div>
                                @if (_form.Id is not null)
                                {
                                    <button type="button" class="btn btn-outline-danger btn-sm" disabled="@_isChanging" @onclick="() => _isDeletePending = true">Delete</button>
                                }
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_isChanging" @onclick="CloseForm">Cancel</button>
                                <button type="submit" class="btn btn-primary btn-sm" disabled="@_isChanging">@(_form.Id is null ? "Add host" : "Save changes")</button>
                            </div>
                        }
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    /// <summary>The address bar's name for the column sorted on, and for the direction.</summary>
    private const string SortQuery = "sort";

    private const string DirectionQuery = "dir";

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    /// <summary>
    /// The order the table is in, kept in the address rather than in a field of this component. A
    /// row opens that host's graph, so the sort has to survive going there and coming back, and a
    /// table sorted to show what is wrong is worth being able to send someone.
    /// </summary>
    [SupplyParameterFromQuery(Name = SortQuery)]
    private string? SortColumn { get; set; }

    [SupplyParameterFromQuery(Name = DirectionQuery)]
    private string? SortDirection { get; set; }

    private HostSort Sort => HostSort.Parse(SortColumn, SortDirection);

    private List<HostSummary> _rows = [];

    // How many missed pings make a host down, as the rows on screen were read with: it travels with
    // them, so a retry count changed on the Configuration page reaches the badges along with the
    // statuses it changes.
    private int _missesToDown = 1;

    // Whether this browser may change anything, asked again on every tick of the timer below, so
    // that a password set or removed elsewhere reaches the controls within a few seconds.
    private bool _isUnlocked;

    // Bumped to have the rows rebuilt rather than diffed; see the key on the row.
    private int _rowGeneration;

    private HostForm _form = new();
    private bool _isFormOpen;
    private InputText? _nameInput;
    private bool _focusNameInput;
    private bool _pressedInsideForm;
    private bool _isDeletePending;

    // Set while a save or a delete is out: the store waits for the summary to be read again before
    // it answers, and the dialog stays on screen meanwhile, so this is what keeps a second click,
    // Escape or a click away from acting on a form whose change is already under way.
    private bool _isChanging;
    private string? _error;

    // Why the last pause or resume was not saved, until the next one is or the reader closes it.
    private string? _switchError;
    private readonly CancellationTokenSource _cts = new();

    /// <summary>
    /// Draws the summary in hand, which is never more than a moment old and never needs a read here;
    /// see <see cref="HostSummaryCache"/>. A live page then follows it as it changes, where a
    /// prerender draws it once and is done.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        Apply(Summaries.Current);
        _isUnlocked = await IsUnlockedAsync();
        if (RendererInfo.IsInteractive)
        {
            Summaries.Updated += OnSummariesUpdated;
            _ = AutoRefreshAsync();
        }
    }

    /// <summary>
    /// Re-orders what is already on screen, which is what a click on a heading comes back to: the
    /// table turns round there and then rather than when the next summary arrives.
    /// </summary>
    protected override void OnParametersSet() => _rows = Sort.Apply(_rows);

    // Focusing the first field also puts the keyboard inside the dialog, which is what lets the
    // Escape key reach OnFormKeyDown.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusNameInput && _nameInput?.Element is { } element)
        {
            _focusNameInput = false;
            await element.FocusAsync();
        }
    }

    /// <summary>
    /// Reads nothing: the rows arrive from the summary as it changes. What still moves on its own is
    /// the clock — "12s ago", an outage that is still counting — and whether this browser is
    /// unlocked, which a password set or removed elsewhere can change.
    /// </summary>
    private async Task AutoRefreshAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                _isUnlocked = await IsUnlockedAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    // Raised on the summary's own loop, so the new rows are handed to this page's circuit to draw.
    private void OnSummariesUpdated(HostSummarySnapshot summary) => _ = InvokeAsync(() =>
    {
        Apply(summary);
        StateHasChanged();
    });

    /// <summary>
    /// Takes a summary as the rows on screen, in this page's order: the rows are every page's, and
    /// the order is only this reader's.
    /// </summary>
    private void Apply(HostSummarySnapshot summary)
    {
        _missesToDown = summary.MissesToDown;
        _rows = Sort.Apply(summary.Rows);
    }

    /// <summary>
    /// Whether this browser may change hosts. Asked again inside every handler below rather than
    /// trusted from the last render: hiding a button is a courtesy to the reader, and this is the
    /// answer that decides whether anything is written.
    /// </summary>
    private async Task<bool> IsUnlockedAsync()
    {
        var user = AuthenticationState is null ? null : (await AuthenticationState).User;
        return Gate.IsUnlocked(user);
    }

    private async Task SaveAsync()
    {
        if (_isChanging)
        {
            return;
        }

        if (!await IsUnlockedAsync())
        {
            _error = "HostPinger is locked. Unlock it to change hosts.";
            return;
        }

        var form = _form;
        HostChange change;
        _isChanging = true;
        try
        {
            change = form.Id is int id
                ? await Store.UpdateAsync(id, form.Name, form.Address, form.IsEnabled, _cts.Token)
                : await Store.AddAsync(form.Name, form.Address, form.IsEnabled, _cts.Token);
        }
        catch (IOException ex)
        {
            _error = ex.Message;
            return;
        }
        finally
        {
            _isChanging = false;
        }

        switch (change.Outcome)
        {
            case HostChangeOutcome.NotFound:
                _error = "This host no longer exists.";
                return;
            case HostChangeOutcome.AddressTaken:
                // Trimmed, because that is the address the store compared.
                _error = $"A host with address \"{form.Address.Trim()}\" already exists.";
                return;
        }

        // The summary the store hands back was read after the change, so the table the form
        // closes onto normally holds it already; when that read could not be made, the change
        // arrives with the next one that can.
        CloseFormOf(form);
        Apply(change.Summary);
    }

    private async Task SetEnabledAsync(int id, bool isEnabled)
    {
        if (!await IsUnlockedAsync())
        {
            // The switch has already moved in the browser, so rebuild the rows to put it back.
            _rowGeneration++;
            Apply(Summaries.Current);
            return;
        }

        HostSummarySnapshot summary;
        try
        {
            summary = await Store.SetEnabledAsync(id, isEnabled, _cts.Token);
        }
        catch (IOException ex)
        {
            // There is no dialog to put the reason in, so it goes above the table, and the switch
            // goes back the way the locked case above puts it back.
            _switchError = ex.Message;
            _rowGeneration++;
            Apply(Summaries.Current);
            return;
        }

        _switchError = null;
        if (_form.Id == id)
        {
            _form.IsEnabled = isEnabled;
        }

        Apply(summary);
    }

    private async Task DeleteAsync(int id)
    {
        if (_isChanging)
        {
            return;
        }

        if (!await IsUnlockedAsync())
        {
            _isDeletePending = false;
            _error = "HostPinger is locked. Unlock it to change hosts.";
            return;
        }

        var form = _form;
        HostSummarySnapshot summary;
        _isChanging = true;
        try
        {
            summary = await Store.DeleteAsync(id, _cts.Token);
        }
        catch (IOException ex)
        {
            // The confirmation sits in the dialog, so the dialog is where the refusal goes.
            _isDeletePending = false;
            _error = ex.Message;
            return;
        }
        finally
        {
            _isChanging = false;
        }

        CloseFormOf(form);
        Apply(summary);
    }

    private void BeginAdd() => OpenForm(new HostForm());

    private void BeginEdit(MonitoredHost host) => OpenForm(new HostForm
    {
        Id = host.Id,
        Name = host.Name,
        Address = host.Address,
        IsEnabled = host.IsEnabled,
    });

    private void OpenForm(HostForm form)
    {
        _form = form;
        _error = null;
        _pressedInsideForm = false;
        _isDeletePending = false;
        _isFormOpen = true;
        _focusNameInput = true;
    }

    private void CloseForm()
    {
        _form = new HostForm();
        _error = null;
        _isDeletePending = false;
        _isFormOpen = false;
    }

    /// <summary>
    /// Closes the form a change was made from, and only that one: by the time the change comes
    /// back, the form on screen could be another.
    /// </summary>
    private void CloseFormOf(HostForm form)
    {
        if (ReferenceEquals(_form, form))
        {
            CloseForm();
        }
    }

    private void OnFormKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && !_isChanging)
        {
            CloseForm();
        }
    }

    /// <summary>
    /// Cancels on a click away. Dragging a text selection out of a field also raises a click on
    /// the overlay, so a press that started inside the dialog is not one — it would throw away
    /// what the user was in the middle of selecting.
    /// </summary>
    private void OnOverlayClick()
    {
        if (!_pressedInsideForm && !_isChanging)
        {
            CloseForm();
        }
    }

    private void OpenGraph(int hostId) => Navigation.NavigateTo($"graph/{hostId}");

    /// <summary>
    /// Opens the graph on the outage this row reports rather than on the live window the row itself
    /// opens.
    /// </summary>
    /// <remarks>
    /// The outage — measured to now while it is still running — goes in the middle of a range
    /// twice its length, pinned where that whole range is already past and cut off at now and left
    /// live where its trailing quarter is still to come; see <see cref="GraphOpening.Around"/>,
    /// which is where the rule and its reasons live. So an outage long over is held still and
    /// centred, and one still running or only just ended opens live, with the recovery — when it
    /// comes — arriving on screen rather than the reader being frozen on a picture of the outage.
    /// A row with no outage to open goes where the row goes.
    /// </remarks>
    private void OpenDowntime(HostSummary row)
    {
        if (row.LastDowntime is not { } downtime)
        {
            OpenGraph(row.Host.Id);
            return;
        }

        var nowUtc = DateTime.UtcNow;
        var opening = GraphOpening.Around(downtime.StartedUtc, downtime.EndedUtc ?? nowUtc, nowUtc);
        Navigation.NavigateTo($"graph/{row.Host.Id}?{opening.QueryString}");
    }

    /// <summary>
    /// What the Last downtime cell offers, which is worth spelling out because it is the one cell
    /// that does not do what the rest of the row does. A cell with no outage in it does, and says
    /// nothing.
    /// </summary>
    private static string? DowntimeTitle(HostSummary row) =>
        row.LastDowntime is null ? null : "Open the graph on this outage";

    /// <summary>
    /// A heading that sorts the table. The heading itself is the button rather than carrying one,
    /// so the whole label is the target and a keyboard reaches it in the order it is read in.
    /// </summary>
    private RenderFragment SortHeader(HostSortColumn column, string label) =>
        @<th aria-sort="@AriaSort(column)">
            <button type="button" class="sort-header" title="@SortTitle(column, label)"
                    @onclick="() => SortBy(column)">
                @label<span class="sort-arrow" aria-hidden="true">@Arrow(column)</span>
            </button>
        </th>;

    /// <summary>
    /// Where a click on this heading would take the table, which is not always obvious from the
    /// heading: the columns that say how a host is doing lead with the worst of it rather than with
    /// the top of a range.
    /// </summary>
    private string SortTitle(HostSortColumn column, string label)
    {
        var next = Sort.ClickedOn(column);
        var end = (column, next.IsDescending) switch
        {
            (HostSortColumn.Status, true) => "down first",
            (HostSortColumn.Status, false) => "paused first",
            (HostSortColumn.LastPing, true) => "slowest first, and no reply before those",
            (HostSortColumn.LastPing, false) => "fastest first",
            (HostSortColumn.LastDowntime, true) => "most recent first",
            (HostSortColumn.LastDowntime, false) => "oldest first",
            (_, true) => "Z to A",
            _ => "A to Z",
        };

        return $"Sort by {label.ToLowerInvariant()}, {end}";
    }

    /// <summary>
    /// The arrow on the sorted heading, pointing the way the column is read: down for a column
    /// starting at its far end. Only the sorted column carries one, and the width it takes is
    /// reserved on every heading so that sorting cannot shift a label sideways.
    /// </summary>
    private string Arrow(HostSortColumn column) =>
        Sort.Column != column ? string.Empty : Sort.IsDescending ? "▼" : "▲";

    /// <summary>
    /// What a screen reader is told about a column. The arrow beside it is hidden from one, so this
    /// is the only thing saying which column the table is in the order of.
    /// </summary>
    private string AriaSort(HostSortColumn column) =>
        Sort.Column != column ? "none" : Sort.IsDescending ? "descending" : "ascending";

    /// <summary>
    /// Takes the click to the address rather than to a field of this component; see
    /// <see cref="SortColumn"/>. The entry is replaced rather than added, so the back button goes
    /// on pointing at wherever the reader came from instead of at their own last click.
    /// </summary>
    private void SortBy(HostSortColumn column)
    {
        var sort = Sort.ClickedOn(column);
        Navigation.NavigateTo(
            Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
            {
                [SortQuery] = sort.QueryColumn,
                [DirectionQuery] = sort.QueryDirection,
            }),
            replace: true);
    }

    private string PauseTitle(bool isEnabled) => _isUnlocked
        ? isEnabled ? "Pause monitoring" : "Resume monitoring"
        : "Unlock to pause or resume monitoring";

    private static string RelativeTime(DateTime timestampUtc)
    {
        var age = DateTime.UtcNow - timestampUtc;
        return age switch
        {
            { TotalSeconds: < 5 } => "just now",
            { TotalMinutes: < 1 } => $"{(int)age.TotalSeconds}s ago",
            { TotalHours: < 1 } => $"{(int)age.TotalMinutes}m ago",
            { TotalDays: < 1 } => $"{(int)age.TotalHours}h ago",
            _ => timestampUtc.ToLocalTime().ToString("g"),
        };
    }

    // Cancelled rather than disposed: a wait on the summary or the timer can still come back after
    // the page has gone and ask this source for its token, which a disposed one answers by throwing.
    public void Dispose()
    {
        Summaries.Updated -= OnSummariesUpdated;
        _cts.Cancel();
    }

    private sealed class HostForm
    {
        public int? Id { get; set; }

        [Required(ErrorMessage = "Name is required.")]
        [StringLength(MonitoredHost.MaxNameLength)]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Address is required.")]
        [StringLength(MonitoredHost.MaxAddressLength)]
        public string Address { get; set; } = string.Empty;

        public bool IsEnabled { get; set; } = true;
    }
}
