@page "/graph"
@page "/graph/{HostIdsSegment}"
@rendermode InteractiveServer
@using HostPinger.Components.Charts
@using HostPinger.Core.Options
@using Microsoft.Extensions.Options
@inject IDbContextFactory<HostPingerDbContext> DbFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IOptions<PingerOptions> PingerOptions
@implements IDisposable

<PageTitle>HostPinger - Graph</PageTitle>

<h1>Graph</h1>

@if (_allHosts.Count == 0)
{
    <p class="text-muted">No hosts configured yet. <a href="/">Add one on the Hosts page.</a></p>
}
else
{
    <div class="graph-layout">
        <div class="graph-main">
            @if (_series.Count == 0)
            {
                <p class="text-muted">Select at least one host to plot.</p>
            }
            else
            {
                <div class="range-bar">
                    <span class="badge @(IsPaused ? "text-bg-warning" : "bg-body-secondary text-body-secondary")">
                        @(IsPaused ? "Paused" : "Live")
                    </span>
                    <span class="range-state">@RangeStateText</span>
                    <span class="range-times">@RangeTimesText</span>
                    @if (IsPaused)
                    {
                        <span class="range-duration">@Downtime.FormatDuration(_rangeEnd - _rangeStart)</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary range-resume" @onclick="ResumeLiveAsync">
                            Resume live
                        </button>
                    }
                </div>

                <LineChart Series="_series" RangeStartUtc="_rangeStart" RangeEndUtc="_rangeEnd" UpdateInterval="_updateInterval"
                           BucketDuration="_bucketDuration" PlotDeviceWidthChanged="OnPlotDeviceWidthChanged"
                           RangeSelected="OnRangeSelectedAsync" />
            }
        </div>

        <div class="graph-settings">
            <div class="btn-group" role="group" aria-label="Time window">
                @foreach (var window in Windows)
                {
                    <button type="button"
                            class="btn btn-sm @(!IsPaused && window.Span == _window ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => SetWindowAsync(window.Span)">@window.Label</button>
                }
            </div>

            <div class="host-picker">
                <button type="button" class="btn btn-outline-secondary dropdown-toggle" @onclick="ToggleDropdown">
                    @SelectionSummary
                </button>
                @if (_dropdownOpen)
                {
                    <div class="picker-backdrop" @onclick="CloseDropdown"></div>
                    <div class="picker-panel">
                        <button type="button" class="btn btn-sm btn-outline-secondary clear-hosts mb-2"
                                disabled="@(_selected.Count == 0)" @onclick="ClearHostsAsync">
                            Clear selection
                        </button>
                        <input @ref="_searchInput" class="form-control form-control-sm mb-2" type="search"
                               placeholder="Search hosts…" value="@_search"
                               @oninput="e => _search = (string?)e.Value ?? string.Empty"
                               @onkeydown="OnSearchKeyDownAsync" />
                        @{ var filtered = FilteredHosts().ToList(); }
                        <div class="picker-list">
                            @foreach (var (host, index) in filtered)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="@($"host-{host.Id}")"
                                           checked="@_selected.Contains(host.Id)"
                                           disabled="@(!_selected.Contains(host.Id) && _selected.Count >= ChartPalette.MaxSeries)"
                                           @onchange="e => ToggleHostAsync(host.Id, (bool)e.Value!)" />
                                    <label class="form-check-label" for="@($"host-{host.Id}")">
                                        <span class="swatch" style="background:@ChartPalette.GetColor(index)"></span>@host.Name
                                        <small class="text-muted ms-1">@host.Address</small>
                                    </label>
                                </div>
                            }
                            @if (filtered.Count == 0)
                            {
                                <div class="text-muted small">No hosts match "@_search".</div>
                            }
                        </div>
                        @if (_selected.Count >= ChartPalette.MaxSeries)
                        {
                            <div class="text-muted small mt-1">Up to @ChartPalette.MaxSeries hosts can be plotted at once.</div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private static readonly (string Label, TimeSpan Span)[] Windows =
    [
        ("15 min", TimeSpan.FromMinutes(15)),
        ("1 h", TimeSpan.FromHours(1)),
        ("6 h", TimeSpan.FromHours(6)),
        ("24 h", TimeSpan.FromHours(24)),
        ("7 d", TimeSpan.FromDays(7)),
    ];

    // Each series is bucketed into one bucket per device pixel of plot width: any denser and points
    // share a physical pixel column, where the extra detail cannot be seen but still costs query
    // payload and SVG. Device pixels rather than CSS pixels, so a HiDPI screen gets the resolution
    // it can actually show — the points then land on sub-CSS-pixel x coordinates, which the SVG
    // carries fine. The chart reports its width only after the browser has laid it out, and a new
    // width takes effect on the next refresh rather than immediately, so until the first tick after
    // layout (and if the measurement never arrives, e.g. with JS disabled) a typical plot width
    // stands in. The bounds keep a collapsed or very large, dense display from producing a useless
    // or unreasonable point count.
    private const int DefaultPointsPerSeries = 600;
    private const int MinPointsPerSeries = 50;
    private const int MaxPointsPerSeries = 8000;

    [Parameter] public string? HostIdsSegment { get; set; }

    private List<MonitoredHost> _allHosts = [];
    private HashSet<int> _selected = [];
    private TimeSpan _window = TimeSpan.FromHours(1);

    // A range dragged out of the chart that does not run up to now, carrying the window width to
    // put back when it is let go of. The range is held as two absolute instants rather than a
    // width, because the whole point of it is that it stays where it was put while the clock moves
    // on; null means the chart is following the clock at _window wide. The width to return to
    // travels with the range rather than sitting in a field of its own so that clearing the one
    // cannot leave the other behind.
    private (DateTime StartUtc, DateTime EndUtc, TimeSpan ResumeWindow)? _pinnedRange;
    private List<ChartSeriesData> _series = [];
    private DateTime _rangeStart;
    private DateTime _rangeEnd;
    private readonly CancellationTokenSource _cts = new();
    private bool _refreshLoopStarted;
    private bool _dropdownOpen;
    private bool _focusSearchPending;
    private string _search = string.Empty;
    private ElementReference _searchInput;
    private TimeSpan _updateInterval;
    private int _pointsPerSeries = DefaultPointsPerSeries;
    private int _loadedPointsPerSeries = DefaultPointsPerSeries;
    private TimeSpan _bucketDuration;
    private bool _awaitingFirstMeasurement = true;

    private bool IsPaused => _pinnedRange is not null;

    /// <summary>What the range on screen is: a width ending now, or a fixed slice of the past.</summary>
    private string RangeStateText => IsPaused ? "Custom range" : $"Last {WindowText}";

    private string WindowText
    {
        get
        {
            foreach (var window in Windows)
            {
                if (window.Span == _window)
                {
                    return window.Label;
                }
            }

            // Zooming into a live window leaves a width no preset has a name for.
            return Downtime.FormatDuration(_window);
        }
    }

    /// <summary>
    /// The range on screen in absolute local time, which is the only form a pinned range can be
    /// read in. The date is repeated on the end of the range only when the range crosses midnight.
    /// </summary>
    private string RangeTimesText
    {
        get
        {
            var start = _rangeStart.ToLocalTime();
            var end = _rangeEnd.ToLocalTime();
            return $"{start:d MMM HH:mm:ss} → {end.ToString(start.Date == end.Date ? "HH:mm:ss" : "d MMM HH:mm:ss")}";
        }
    }

    private string SelectionSummary => _selected.Count switch
    {
        0 => "Select hosts…",
        1 => _allHosts.FirstOrDefault(h => h.Id == _selected.First())?.Name ?? "1 host selected",
        var count => $"{count} hosts selected",
    };

    protected override async Task OnParametersSetAsync()
    {
        _selected = ParseIds(HostIdsSegment);
        _updateInterval = TimeSpan.FromSeconds(Math.Max(1, PingerOptions.Value.IntervalSeconds));
        await LoadAsync();
        if (!_refreshLoopStarted)
        {
            _refreshLoopStarted = true;
            _ = AutoRefreshAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusSearchPending)
        {
            _focusSearchPending = false;
            await _searchInput.FocusAsync();
        }
    }

    private void ToggleDropdown()
    {
        _dropdownOpen = !_dropdownOpen;
        if (_dropdownOpen)
        {
            _search = string.Empty;
            _focusSearchPending = true;
        }
    }

    private void CloseDropdown() => _dropdownOpen = false;

    private async Task OnSearchKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseDropdown();
            return;
        }

        if (e.Key != "Enter")
        {
            return;
        }

        // Enter is a shortcut for the single match: toggle it and close the picker.
        var matches = FilteredHosts().ToList();
        if (matches.Count != 1)
        {
            return;
        }

        var hostId = matches[0].Host.Id;
        var isSelected = _selected.Contains(hostId);
        if (!isSelected && _selected.Count >= ChartPalette.MaxSeries)
        {
            return;
        }

        await ToggleHostAsync(hostId, !isSelected);
        CloseDropdown();
    }

    private IEnumerable<(MonitoredHost Host, int Index)> FilteredHosts()
    {
        var hosts = _allHosts.Select((host, index) => (Host: host, Index: index));
        if (string.IsNullOrWhiteSpace(_search))
        {
            return hosts;
        }

        return hosts.Where(t =>
            t.Host.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || t.Host.Address.Contains(_search, StringComparison.OrdinalIgnoreCase));
    }

    private async Task AutoRefreshAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                // A pinned range covers a stretch of the past that is not going to change, and
                // holding still is the point of pinning it, so the tick does nothing. The one
                // exception is a resize: how densely the range is sampled is tied to the plot's
                // pixel width, and without this the line would stay at the old width's resolution
                // until the chart was live again.
                if (IsPaused && _pointsPerSeries == _loadedPointsPerSeries)
                {
                    continue;
                }

                await LoadAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task LoadAsync()
    {
        if (_pinnedRange is (DateTime pinnedStart, DateTime pinnedEnd, _))
        {
            _rangeStart = pinnedStart;
            _rangeEnd = pinnedEnd;
        }
        else
        {
            _rangeEnd = DateTime.UtcNow;
            _rangeStart = _rangeEnd - _window;
        }

        await using var db = await DbFactory.CreateDbContextAsync(_cts.Token);
        _allHosts = await db.Hosts.AsNoTracking().OrderBy(h => h.Id).ToListAsync(_cts.Token);

        var ids = _selected.Where(id => _allHosts.Any(h => h.Id == id)).ToArray();
        var attempts = await db.PingAttempts.AsNoTracking()
            .Where(a => ids.Contains(a.HostId) && a.TimestampUtc >= _rangeStart)
            .OrderBy(a => a.TimestampUtc)
            .Select(a => new { a.HostId, a.TimestampUtc, a.RoundtripMs })
            .ToListAsync(_cts.Token);
        var samplesByHost = attempts
            .GroupBy(a => a.HostId)
            .ToDictionary(
                g => g.Key,
                g => (IReadOnlyList<ChartSample>)g.Select(a => new ChartSample(a.TimestampUtc, a.RoundtripMs)).ToList());

        // Read once, so a resize partway through cannot leave series in the same load at different
        // densities.
        var points = _pointsPerSeries;
        _loadedPointsPerSeries = points;

        // Derived from the very range and count the series below are built with, so the chart can
        // never be told a bucket width the samples it is holding were not bucketed at.
        _bucketDuration = ChartMath.BucketDuration(_rangeStart, _rangeEnd, points);
        _series = _allHosts
            .Select((host, index) => (host, index))
            .Where(t => _selected.Contains(t.host.Id))
            .Select(t => new ChartSeriesData(
                t.host.Name,
                ChartPalette.GetColor(t.index),
                ChartMath.Downsample(
                    samplesByHost.GetValueOrDefault(t.host.Id) ?? Array.Empty<ChartSample>(),
                    _rangeStart,
                    _rangeEnd,
                    points)))
            .ToList();
    }

    private async Task ToggleHostAsync(int hostId, bool isChecked)
    {
        if (isChecked)
        {
            _selected.Add(hostId);
        }
        else
        {
            _selected.Remove(hostId);
        }

        // Update the URL without navigating: a navigation would remount the page (per-page
        // interactivity) and close the picker while the user is still selecting hosts.
        var url = _selected.Count == 0
            ? "graph"
            : $"graph/{string.Join(',', _allHosts.Where(h => _selected.Contains(h.Id)).Select(h => h.Id))}";
        await JS.InvokeVoidAsync("history.replaceState", null, string.Empty, Navigation.ToAbsoluteUri(url).ToString());
        await LoadAsync();
    }

    private async Task ClearHostsAsync()
    {
        if (_selected.Count == 0)
        {
            return;
        }

        _selected.Clear();
        await JS.InvokeVoidAsync("history.replaceState", null, string.Empty, Navigation.ToAbsoluteUri("graph").ToString());
        await LoadAsync();
    }

    // Recorded for the next refresh rather than acted on: while the window is being dragged, the
    // chart rescales the samples it already has, and the density catches up on the following tick.
    // Reloading on the width itself would run a query for every pixel of the drag. The first
    // measurement is the exception — it replaces a stand-in default that was only ever a guess, so
    // it is worth showing straight away rather than up to an interval later.
    private void OnPlotDeviceWidthChanged(double deviceWidth)
    {
        _pointsPerSeries = Math.Clamp((int)Math.Round(deviceWidth), MinPointsPerSeries, MaxPointsPerSeries);
        if (_awaitingFirstMeasurement)
        {
            _awaitingFirstMeasurement = false;
            _ = ApplyFirstMeasurementAsync();
        }
    }

    // The chart reports its width from inside its own layout pass, so this cannot be awaited there
    // and is queued onto the circuit instead. By the time it runs a scheduled refresh may already
    // have picked the new count up, hence the re-check.
    private async Task ApplyFirstMeasurementAsync()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                if (_pointsPerSeries != _loadedPointsPerSeries)
                {
                    await LoadAsync();
                    StateHasChanged();
                }
            });
        }
        catch (OperationCanceledException)
        {
            // The page was disposed while the reload was queued.
        }
    }

    private async Task SetWindowAsync(TimeSpan window)
    {
        _window = window;
        _pinnedRange = null;
        await LoadAsync();
    }

    /// <summary>
    /// Applies a range dragged out of the chart. A drag that ran up to the right-hand edge of a
    /// live chart picked a width ending at now, so it goes on following the clock, only narrower;
    /// anything else picked a fixed stretch of the past, and the refresh has to stop overwriting it
    /// or it would be dragged back to the present within five seconds.
    /// </summary>
    private async Task OnRangeSelectedAsync(ChartSelection selection)
    {
        // Reaching that edge only means "up to now" while the chart is following the clock. On a
        // range that is already pinned it is the end of the pinned range, which is a moment in the
        // past like any other in it, so zooming into one stays paused however far right it goes.
        if (selection.ReachesRangeEnd && !IsPaused)
        {
            _window = selection.EndUtc - selection.StartUtc;
        }
        else
        {
            // The window to come back to is taken on the way in and then carried across any further
            // zooming: narrowing a pinned range again is still the same excursion into the past,
            // and resuming should undo the whole of it rather than one step of it.
            _pinnedRange = (
                selection.StartUtc,
                selection.EndUtc,
                _pinnedRange?.ResumeWindow ?? _window);
        }

        await LoadAsync();
    }

    /// <summary>
    /// Follows the clock again over the window that was on screen before the zoom, so that leaving
    /// a pinned range puts the chart back where it was rather than at whatever width happened to be
    /// dragged out along the way.
    /// </summary>
    private async Task ResumeLiveAsync()
    {
        if (_pinnedRange is not (_, _, TimeSpan resumeWindow))
        {
            return;
        }

        _window = resumeWindow;
        _pinnedRange = null;
        await LoadAsync();
    }

    private static HashSet<int> ParseIds(string? segment)
    {
        var ids = new HashSet<int>();
        foreach (var part in (segment ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (int.TryParse(part, out var id))
            {
                ids.Add(id);
            }
        }

        return ids;
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
