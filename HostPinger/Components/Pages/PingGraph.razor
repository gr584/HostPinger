@page "/graph"
@page "/graph/{HostIdsSegment}"
@rendermode InteractiveServer
@using HostPinger.Components.Charts
@using HostPinger.Core.Options
@using HostPinger.Core.Services
@inject DatabaseReads Reads
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject UserSettingsStore Settings
@inject PrerenderHandoff Handoff
@implements IDisposable

<PageTitle>HostPinger - Graph</PageTitle>

<h1>Graph</h1>

@if (_allHosts.Count == 0)
{
    <p class="text-muted">No hosts configured yet. <a href="/">Add one on the Hosts page.</a></p>
}
else
{
    <div class="graph-layout">
        <div class="graph-main">
            @if (_series.Count == 0)
            {
                <p class="text-muted">Select at least one host to plot.</p>
            }
            else
            {
                <div class="range-bar">
                    <span class="badge @(IsPaused ? "text-bg-warning" : "bg-body-secondary text-body-secondary")">
                        @(IsPaused ? "Paused" : "Live")
                    </span>
                    <span class="range-state">@RangeStateText</span>
                    <span class="range-times">@RangeTimesText</span>
                    @if (IsPaused)
                    {
                        <span class="range-duration">@Downtime.FormatDuration(_rangeEnd - _rangeStart)</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary range-resume" @onclick="ResumeLiveAsync">
                            Resume live
                        </button>
                    }
                </div>

                <LineChart Series="_series" RangeStartUtc="_rangeStart" RangeEndUtc="_rangeEnd" UpdateInterval="UpdateInterval"
                           BucketDuration="_bucketDuration" PlotDeviceWidthChanged="OnPlotDeviceWidthChanged"
                           RangeSelected="OnRangeSelectedAsync" />
            }
        </div>

        <div class="graph-settings">
            <div class="btn-group" role="group" aria-label="Time window">
                @foreach (var window in Windows)
                {
                    <button type="button"
                            class="btn btn-sm @(!IsPaused && window.Span == _window ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => SetWindowAsync(window.Span)">@window.Label</button>
                }
            </div>

            <div class="host-picker">
                <button type="button" class="btn btn-outline-secondary dropdown-toggle" @onclick="ToggleDropdown">
                    @SelectionSummary
                </button>
                @if (_dropdownOpen)
                {
                    <div class="picker-backdrop" @onclick="CloseDropdown"></div>
                    <div class="picker-panel">
                        <button type="button" class="btn btn-sm btn-outline-secondary clear-hosts mb-2"
                                disabled="@(_selected.Count == 0)" @onclick="ClearHostsAsync">
                            Clear selection
                        </button>
                        <input @ref="_searchInput" class="form-control form-control-sm mb-2" type="search"
                               placeholder="Search hosts…" value="@_search"
                               @oninput="e => _search = (string?)e.Value ?? string.Empty"
                               @onkeydown="OnSearchKeyDownAsync" />
                        @{ var filtered = FilteredHosts().ToList(); }
                        <div class="picker-list">
                            @foreach (var (host, index) in filtered)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="@($"host-{host.Id}")"
                                           checked="@_selected.Contains(host.Id)"
                                           disabled="@(!_selected.Contains(host.Id) && _selected.Count >= ChartPalette.MaxSeries)"
                                           @onchange="e => ToggleHostAsync(host.Id, (bool)e.Value!)" />
                                    <label class="form-check-label" for="@($"host-{host.Id}")">
                                        <span class="swatch" style="background:@ChartPalette.GetColor(index)"></span>@host.Name
                                        <small class="text-muted ms-1">@host.Address</small>
                                    </label>
                                </div>
                            }
                            @if (filtered.Count == 0)
                            {
                                <div class="text-muted small">No hosts match "@_search".</div>
                            }
                        </div>
                        @if (_selected.Count >= ChartPalette.MaxSeries)
                        {
                            <div class="text-muted small mt-1">Up to @ChartPalette.MaxSeries hosts can be plotted at once.</div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private static readonly (string Label, TimeSpan Span)[] Windows =
    [
        ("15 min", TimeSpan.FromMinutes(15)),
        ("1 h", TimeSpan.FromHours(1)),
        ("6 h", TimeSpan.FromHours(6)),
        ("24 h", TimeSpan.FromHours(24)),
        ("7 d", TimeSpan.FromDays(7)),
    ];

    // Each series is bucketed into one bucket per device pixel of plot width: any denser and points
    // share a physical pixel column, where the extra detail cannot be seen but still costs query
    // payload and SVG. Device pixels rather than CSS pixels, so a HiDPI screen gets the resolution
    // it can actually show — the points then land on sub-CSS-pixel x coordinates, which the SVG
    // carries fine. The chart reports its width only after the browser has laid it out, and a new
    // width takes effect on the next refresh rather than immediately, so until the first tick after
    // layout (and if the measurement never arrives, e.g. with JS disabled) a typical plot width
    // stands in. The bounds keep a collapsed or very large, dense display from producing a useless
    // or unreasonable point count.
    private const int DefaultPointsPerSeries = 600;
    private const int MinPointsPerSeries = 50;
    private const int MaxPointsPerSeries = 8000;

    [Parameter] public string? HostIdsSegment { get; set; }

    /// <summary>
    /// What the address asks the chart to open on: a fixed period as its two ends, or a live
    /// window as its width. Carried in the address so that a link can point the chart at either —
    /// which is how the Hosts page's Last downtime column opens the graph on the outage it reports,
    /// paused on one that is well over and live on one still running or only just ended. Read as
    /// text rather than as typed
    /// parameters so that this page decides what an unreadable one means; see
    /// <see cref="GraphOpening.Parse"/>.
    /// </summary>
    [SupplyParameterFromQuery(Name = GraphOpening.StartQuery)]
    private string? PeriodStartQuery { get; set; }

    [SupplyParameterFromQuery(Name = GraphOpening.EndQuery)]
    private string? PeriodEndQuery { get; set; }

    [SupplyParameterFromQuery(Name = GraphOpening.WindowQuery)]
    private string? WindowWidthQuery { get; set; }

    private IReadOnlyList<MonitoredHost> _allHosts = [];
    private HashSet<int> _selected = [];
    private TimeSpan _window = TimeSpan.FromHours(1);

    // A range dragged out of the chart that does not run up to now, carrying the window width to
    // put back when it is let go of. The range is held as two absolute instants rather than a
    // width, because the whole point of it is that it stays where it was put while the clock moves
    // on; null means the chart is following the clock at _window wide. The width to return to
    // travels with the range rather than sitting in a field of its own so that clearing the one
    // cannot leave the other behind.
    private (DateTime StartUtc, DateTime EndUtc, TimeSpan ResumeWindow)? _pinnedRange;
    private List<ChartSeriesData> _series = [];

    // The read behind each plotted host's series, by host id, which is what the next refresh
    // carries on from; see ChartSeries.RefreshAsync. Replaced whole along with the series, and never
    // changed in place, so a read that is out can hold it while the page moves on.
    private IReadOnlyDictionary<int, ChartSeriesRead> _seriesReads = new Dictionary<int, ChartSeriesRead>();

    private DateTime _rangeStart;
    private DateTime _rangeEnd;
    private readonly PageReads _reads = new();
    private readonly CancellationTokenSource _cts = new();
    private bool _refreshLoopStarted;

    // Refreshes since the series were last read from scratch rather than carried on, and how many
    // carry on before the next one is: sixty, against the five-second timer below, is five minutes.
    private int _refreshesSinceFullRead;
    private const int RefreshesPerFullRead = 60;

    /// <summary>
    /// Where the read the prerender drew the page from is held for the live page, which starts from
    /// the same picture rather than reading it again: on a two-month outage that second read added
    /// a third of a second to every opening of the graph. Only the id goes through the page; the
    /// read stays on the server, see <see cref="PrerenderHandoff"/>. Set only while prerendering,
    /// and not brought back to a circuit that was paused and resumed, whose read is long gone; see
    /// <see cref="TakePrerenderRead"/> for how the live page uses it.
    /// </summary>
    /// <remarks>
    /// AllowUpdates, because a page opened by an enhanced navigation is handed its state as an
    /// update rather than as the value it starts with. The Hosts page's Last downtime cell opens
    /// the graph that way, and without it the live page never saw the id and read twice as before.
    /// </remarks>
    [PersistentState(RestoreBehavior = RestoreBehavior.SkipLastSnapshot, AllowUpdates = true)]
    public string? PrerenderReadId { get; set; }

    // Whether the live page has had its one chance at the prerender's read.
    private bool _prerenderReadTaken;
    private bool _dropdownOpen;
    private bool _focusSearchPending;
    private string _search = string.Empty;
    private ElementReference _searchInput;
    private int _pointsPerSeries = DefaultPointsPerSeries;

    // The density of the last read sent rather than of the series on screen: the last read sent is
    // the one that ends up drawn (see PageReads), so a match means one at this density is already on
    // its way and need not be asked for again.
    private int _loadedPointsPerSeries = DefaultPointsPerSeries;
    private TimeSpan _bucketDuration;
    private bool _awaitingFirstMeasurement = true;

    // What the address last asked this page to open on, and it acted on; see ApplyQueryOpening.
    private GraphOpening? _appliedQueryOpening;

    private bool IsPaused => _pinnedRange is not null;

    /// <summary>
    /// How often the pinger records, which is what the chart measures a hole in the line against.
    /// From the settings store, where the interval has lived since it became editable on the
    /// Configuration page — appsettings.json holds only the default it overrides — and read at each
    /// render, so that a change made there reaches an open graph on its next refresh.
    /// </summary>
    private TimeSpan UpdateInterval => TimeSpan.FromSeconds(Math.Max(1, Settings.CurrentPinger.IntervalSeconds));

    /// <summary>What the range on screen is: a width ending now, or a fixed slice of the past.</summary>
    private string RangeStateText => IsPaused ? "Custom range" : $"Last {WindowText}";

    private string WindowText
    {
        get
        {
            foreach (var window in Windows)
            {
                if (window.Span == _window)
                {
                    return window.Label;
                }
            }

            // Zooming into a live window leaves a width no preset has a name for.
            return Downtime.FormatDuration(_window);
        }
    }

    /// <summary>
    /// The range on screen in absolute local time, which is the only form a pinned range can be
    /// read in. The date is repeated on the end of the range only when the range crosses midnight.
    /// </summary>
    private string RangeTimesText
    {
        get
        {
            var start = _rangeStart.ToLocalTime();
            var end = _rangeEnd.ToLocalTime();
            return $"{start:d MMM HH:mm:ss} → {end.ToString(start.Date == end.Date ? "HH:mm:ss" : "d MMM HH:mm:ss")}";
        }
    }

    private string SelectionSummary => _selected.Count switch
    {
        0 => "Select hosts…",
        1 => _allHosts.FirstOrDefault(h => h.Id == _selected.First())?.Name ?? "1 host selected",
        var count => $"{count} hosts selected",
    };

    protected override async Task OnParametersSetAsync()
    {
        _selected = ParseIds(HostIdsSegment);
        ApplyQueryOpening();
        if (TakePrerenderRead() is { } prerendered)
        {
            // At the density the prerender read at, which is as good a guess at the chart's width
            // as the live page has until the chart measures itself.
            Apply(prerendered);
            _pointsPerSeries = prerendered.Points;
            _loadedPointsPerSeries = prerendered.Points;
            _reads.HandBackRestored();
        }
        else
        {
            await LoadAsync();
        }

        if (!_refreshLoopStarted)
        {
            _refreshLoopStarted = true;
            _ = AutoRefreshAsync();
        }
    }

    /// <summary>
    /// The prerender's read, for the live page's first parameters set and no other, and only while
    /// it is still the read this page would make: the same hosts, and the same range or window. On
    /// a page the prerender drew it always is, since both come from one address; the check is what
    /// keeps a value from anywhere else from being drawn as though it were. An enhanced navigation
    /// that the live page stays open through hands it the id of that navigation's prerender too;
    /// the page reads for the new address itself, and that read is left to expire.
    /// </summary>
    private GraphRead? TakePrerenderRead()
    {
        if (!RendererInfo.IsInteractive || _prerenderReadTaken)
        {
            return null;
        }

        _prerenderReadTaken = true;
        if (PrerenderReadId is not { } id || Handoff.Take<GraphRead>(id) is not { } read)
        {
            return null;
        }

        var plotted = _selected.Where(selectedId => read.Hosts.Any(h => h.Id == selectedId)).ToHashSet();
        var sameRange = _pinnedRange is (DateTime start, DateTime end, _)
            ? read.RangeStartUtc == start && read.RangeEndUtc == end
            : read.RangeEndUtc - read.RangeStartUtc == _window;
        return plotted.SetEquals(read.SeriesReads.Keys) && sameRange ? read : null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusSearchPending)
        {
            _focusSearchPending = false;
            await _searchInput.FocusAsync();
        }
    }

    private void ToggleDropdown()
    {
        _dropdownOpen = !_dropdownOpen;
        if (_dropdownOpen)
        {
            _search = string.Empty;
            _focusSearchPending = true;
        }
    }

    private void CloseDropdown() => _dropdownOpen = false;

    private async Task OnSearchKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseDropdown();
            return;
        }

        if (e.Key != "Enter")
        {
            return;
        }

        // Enter is a shortcut for the single match: toggle it and close the picker.
        var matches = FilteredHosts().ToList();
        if (matches.Count != 1)
        {
            return;
        }

        var hostId = matches[0].Host.Id;
        var isSelected = _selected.Contains(hostId);
        if (!isSelected && _selected.Count >= ChartPalette.MaxSeries)
        {
            return;
        }

        await ToggleHostAsync(hostId, !isSelected);
        CloseDropdown();
    }

    /// <summary>
    /// The rows of the picker: every host by name, cut down to whatever the search box matches.
    /// Names are not unique — only addresses are — so two that share one fall back to the address
    /// that tells them apart, rather than to whichever the database happened to hand over first.
    /// </summary>
    /// <remarks>
    /// The index each row carries is the host's position in <see cref="_allHosts"/>, which is by id
    /// — the order the hosts were added — and is what picks its colour, both for the swatch here and
    /// for its line on the chart. It is taken before this sorts or filters anything, so that a host
    /// keeps its colour whatever the list around it does: alphabetical order is for reading the list
    /// in, and it must not repaint a chart that is being watched. That is also why the hosts are not
    /// simply read out of the database in name order — a host added or renamed would then shift the
    /// colour of every host after it.
    /// </remarks>
    private IEnumerable<(MonitoredHost Host, int Index)> FilteredHosts()
    {
        var hosts = _allHosts
            .Select((host, index) => (Host: host, Index: index))
            .OrderBy(t => t.Host.Name, StringComparer.OrdinalIgnoreCase)
            .ThenBy(t => t.Host.Address, StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrWhiteSpace(_search))
        {
            return hosts;
        }

        return hosts.Where(t =>
            t.Host.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || t.Host.Address.Contains(_search, StringComparison.OrdinalIgnoreCase));
    }

    private async Task AutoRefreshAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                // A pinned range covers a stretch of the past that is not going to change, and
                // holding still is the point of pinning it, so the tick does nothing. The one
                // exception is a resize: how densely the range is sampled is tied to the plot's
                // pixel width, and without this the line would stay at the old width's resolution
                // until the chart was live again.
                if (IsPaused && _pointsPerSeries == _loadedPointsPerSeries)
                {
                    continue;
                }

                // Carried on from what is on screen, which reads only the buckets still filling,
                // except once in every RefreshesPerFullRead. A carried-on series cannot see rows
                // that change behind its newest point — the pruner trimming the oldest history, a
                // restore — and this bounds how long it can go on showing them.
                await LoadAsync(carryOn: ++_refreshesSinceFullRead < RefreshesPerFullRead);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    /// <summary>
    /// Reads the hosts and the plotted series again, off the circuit once the page has drawn any;
    /// see <see cref="PageReads"/>. Everything the read is made from — the range, the density, the
    /// selection — is taken before it is sent, and the range reaches the screen with the series it
    /// was read for, so the chart is never laying one read's samples along another read's axis.
    /// </summary>
    /// <param name="carryOn">
    /// Whether each series may be carried on from the read behind what is on screen rather than
    /// read from scratch, which is what the timer asks for. ChartSeries.RefreshAsync decides per
    /// host whether it can, so a change the timer did not make — a resize, another window — still
    /// reads in full, as does a host the screen does not hold yet.
    /// </param>
    private async Task LoadAsync(bool carryOn = false)
    {
        if (!carryOn)
        {
            _refreshesSinceFullRead = 0;
        }

        var earlier = carryOn ? _seriesReads : null;

        DateTime rangeStart;
        DateTime rangeEnd;
        if (_pinnedRange is (DateTime pinnedStart, DateTime pinnedEnd, _))
        {
            rangeStart = pinnedStart;
            rangeEnd = pinnedEnd;
        }
        else
        {
            rangeEnd = DateTime.UtcNow;
            rangeStart = rangeEnd - _window;
        }

        // Read once, so a resize partway through cannot leave series in the same load at different
        // densities.
        var points = _pointsPerSeries;
        _loadedPointsPerSeries = points;

        // A copy, because the picker goes on ticking hosts in and out of the set while the read is out.
        var selected = _selected.ToHashSet();

        // See GraphRead.LoadAsync for what is read and why each plotted host is a read of its own.
        var read = await _reads.ReadAsync(
            cancellationToken => Reads.ReadGraphAsync(selected, earlier, rangeStart, rangeEnd, points, cancellationToken),
            _cts.Token);

        // Overtaken by a read sent after it, which has already put something newer on screen.
        if (read is null)
        {
            return;
        }

        Apply(read);

        // Held for the live page while this is the prerender; see PrerenderReadId.
        if (!RendererInfo.IsInteractive)
        {
            PrerenderReadId = Handoff.Hold(read);
        }
    }

    /// <summary>
    /// Puts a read on screen: its range, every host, and a series for each plotted host, coloured
    /// by the host's place in the list. The one place a read becomes what the chart draws, whether
    /// it was read here or handed over by the prerender.
    /// </summary>
    private void Apply(GraphRead read)
    {
        _rangeStart = read.RangeStartUtc;
        _rangeEnd = read.RangeEndUtc;

        // Derived from the very range and count the series were built with, so the chart can never
        // be told a bucket width the samples it is holding were not bucketed at.
        _bucketDuration = ChartMath.BucketDuration(read.RangeStartUtc, read.RangeEndUtc, read.Points);
        _allHosts = read.Hosts;
        _seriesReads = read.SeriesReads;

        var series = new List<ChartSeriesData>();
        for (var index = 0; index < read.Hosts.Count; index++)
        {
            var host = read.Hosts[index];
            if (read.SeriesReads.TryGetValue(host.Id, out var seriesRead))
            {
                series.Add(new ChartSeriesData(host.Name, ChartPalette.GetColor(index), seriesRead.Samples));
            }
        }

        _series = series;
    }

    /// <summary>
    /// Opens on whatever the address asks for. A period pins the chart exactly as dragging one out
    /// of it does: it holds still and the five-second refresh leaves it alone until it is resumed,
    /// to the window the page would have opened on had the address said nothing, since there was no
    /// window on screen before it to put back. A width leaves the chart following the clock over
    /// that much time, so what is on it goes on arriving.
    /// </summary>
    /// <remarks>
    /// Acted on once per opening rather than once per parameters set: the picker rewrites the
    /// address as hosts are ticked, and applying it again on the way through would drag a reader
    /// who had resumed live, or picked a window of their own, back to what they arrived on. An
    /// address asking for something else is a request of its own and is acted on in its turn.
    /// </remarks>
    private void ApplyQueryOpening()
    {
        var opening = GraphOpening.Parse(PeriodStartQuery, PeriodEndQuery, WindowWidthQuery);
        if (opening is null || opening == _appliedQueryOpening)
        {
            return;
        }

        _appliedQueryOpening = opening;
        switch (opening)
        {
            case GraphOpening.Period period:
                _pinnedRange = (period.StartUtc, period.EndUtc, _window);
                break;

            case GraphOpening.Window window:
                _window = window.Width;
                _pinnedRange = null;
                break;
        }
    }

    private async Task ToggleHostAsync(int hostId, bool isChecked)
    {
        if (isChecked)
        {
            _selected.Add(hostId);
        }
        else
        {
            _selected.Remove(hostId);
        }

        // Update the URL without navigating: a navigation would remount the page (per-page
        // interactivity) and close the picker while the user is still selecting hosts.
        var url = _selected.Count == 0
            ? "graph"
            : $"graph/{string.Join(',', _allHosts.Where(h => _selected.Contains(h.Id)).Select(h => h.Id))}";
        await JS.InvokeVoidAsync("history.replaceState", null, string.Empty, Navigation.ToAbsoluteUri(url).ToString());
        await LoadAsync();
    }

    private async Task ClearHostsAsync()
    {
        if (_selected.Count == 0)
        {
            return;
        }

        _selected.Clear();
        await JS.InvokeVoidAsync("history.replaceState", null, string.Empty, Navigation.ToAbsoluteUri("graph").ToString());
        await LoadAsync();
    }

    // Recorded for the next refresh rather than acted on: while the window is being dragged, the
    // chart rescales the samples it already has, and the density catches up on the following tick.
    // Reloading on the width itself would run a query for every pixel of the drag. The first
    // measurement is the exception — it replaces a stand-in default that was only ever a guess, so
    // it is worth showing straight away rather than up to an interval later.
    private void OnPlotDeviceWidthChanged(double deviceWidth)
    {
        _pointsPerSeries = Math.Clamp((int)Math.Round(deviceWidth), MinPointsPerSeries, MaxPointsPerSeries);
        if (_awaitingFirstMeasurement)
        {
            _awaitingFirstMeasurement = false;
            _ = ApplyFirstMeasurementAsync();
        }
    }

    // The chart reports its width from inside its own layout pass, so this cannot be awaited there
    // and is queued onto the circuit instead. By the time it runs a scheduled refresh may already
    // have picked the new count up, hence the re-check.
    private async Task ApplyFirstMeasurementAsync()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                if (_pointsPerSeries != _loadedPointsPerSeries)
                {
                    await LoadAsync();
                    StateHasChanged();
                }
            });
        }
        catch (OperationCanceledException)
        {
            // The page was disposed while the reload was queued.
        }
    }

    private async Task SetWindowAsync(TimeSpan window)
    {
        _window = window;
        _pinnedRange = null;
        await LoadAsync();
    }

    /// <summary>
    /// Applies a range dragged out of the chart. A drag that ran up to the right-hand edge of a
    /// live chart picked a width ending at now, so it goes on following the clock, only narrower;
    /// anything else picked a fixed stretch of the past, and the refresh has to stop overwriting it
    /// or it would be dragged back to the present within five seconds.
    /// </summary>
    private async Task OnRangeSelectedAsync(ChartSelection selection)
    {
        // Reaching that edge only means "up to now" while the chart is following the clock. On a
        // range that is already pinned it is the end of the pinned range, which is a moment in the
        // past like any other in it, so zooming into one stays paused however far right it goes.
        if (selection.ReachesRangeEnd && !IsPaused)
        {
            _window = selection.EndUtc - selection.StartUtc;
        }
        else
        {
            // The window to come back to is taken on the way in and then carried across any further
            // zooming: narrowing a pinned range again is still the same excursion into the past,
            // and resuming should undo the whole of it rather than one step of it.
            _pinnedRange = (
                selection.StartUtc,
                selection.EndUtc,
                _pinnedRange?.ResumeWindow ?? _window);
        }

        await LoadAsync();
    }

    /// <summary>
    /// Follows the clock again over the window that was on screen before the zoom, so that leaving
    /// a pinned range puts the chart back where it was rather than at whatever width happened to be
    /// dragged out along the way.
    /// </summary>
    private async Task ResumeLiveAsync()
    {
        if (_pinnedRange is not (_, _, TimeSpan resumeWindow))
        {
            return;
        }

        _window = resumeWindow;
        _pinnedRange = null;
        await LoadAsync();
    }

    private static HashSet<int> ParseIds(string? segment)
    {
        var ids = new HashSet<int>();
        foreach (var part in (segment ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (int.TryParse(part, out var id))
            {
                ids.Add(id);
            }
        }

        return ids;
    }

    // Cancelled rather than disposed, because a read can land after the page has gone; see PageReads.
    public void Dispose() => _cts.Cancel();
}
