@page "/password"
@using System.ComponentModel.DataAnnotations
@using HostPinger.Core.Options
@using HostPinger.Security
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject PasswordGate Gate
@inject PasswordAttempts Attempts
@inject PingerSettingsStore SettingsStore
@inject NavigationManager Navigation
@inject ILogger<Password> Logger

<PageTitle>HostPinger - Password</PageTitle>

<h1>Password</h1>

<div class="row">
    <div class="col-12 col-md-8 col-xl-5">
        @if (Gate.IsPasswordSet && !IsUnlocked)
        {
            <div class="card">
                <div class="card-body">
                    <p>HostPinger is locked. The password can only be changed from an unlocked browser.</p>
                    @*
                        A link that asks the layout for the unlock overlay rather than a button that
                        tells it: this page is rendered statically, so it writes the cookie the
                        password form needs and has no click of its own to run anything on.

                        data-enhance-nav="false" makes it a real page load. Enhanced navigation
                        would leave the overlay drawn from this response while the live one in the
                        layout carried on believing it was closed — it would appear, but its Escape,
                        its Cancel and its click away would all be inert. Loading the page builds
                        the overlay along with the rest of it.
                    *@
                    <a class="btn btn-primary btn-sm" data-enhance-nav="false"
                       href="@($"password?{LockFormNames.OpenQuery}=1")">Unlock</a>
                </div>
            </div>
        }
        else
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">@(Gate.IsPasswordSet ? "Change password" : "Set a password")</h5>
                    @*
                        Plain inputs rather than InputText throughout, for the reason given on the
                        unlock page: InputText renders its bound value back into the markup, which
                        would write the passwords just submitted into the HTML of the page that
                        reports what was wrong with them.
                    *@
                    <EditForm Model="ChangeModel" FormName="change-password" OnValidSubmit="ChangeAsync">
                        <DataAnnotationsValidator />
                        @if (_changeError is not null)
                        {
                            <div class="alert alert-danger py-2">@_changeError</div>
                        }
                        @if (Gate.IsPasswordSet)
                        {
                            @*
                                Asked for even though this browser is unlocked, so that a browser
                                left open and walked away from cannot be used to take the password
                                over.
                            *@
                            <div class="mb-2">
                                <label class="form-label" for="current-password">Current password</label>
                                <input id="current-password" type="password" name="ChangeModel.Current"
                                       class="form-control form-control-sm" autocomplete="current-password" />
                            </div>
                        }
                        <div class="mb-2">
                            <label class="form-label" for="new-password">New password</label>
                            <input id="new-password" type="password" name="ChangeModel.New"
                                   class="form-control form-control-sm" autocomplete="new-password" />
                            <ValidationMessage For="() => ChangeModel!.New" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="confirm-password">Confirm new password</label>
                            <input id="confirm-password" type="password" name="ChangeModel.Confirm"
                                   class="form-control form-control-sm" autocomplete="new-password" />
                            <ValidationMessage For="() => ChangeModel!.Confirm" />
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm">
                            @(Gate.IsPasswordSet ? "Change password" : "Set password")
                        </button>
                        <a class="btn btn-outline-secondary btn-sm" href="configuration">Cancel</a>
                        <div class="form-text">
                            @if (Gate.IsPasswordSet)
                            {
                                <text>
                                    Every other browser that is unlocked now will have to unlock
                                    again with the new password.
                                </text>
                            }
                            else
                            {
                                <text>
                                    Locks adding, editing and removing hosts, pausing them, and
                                    changing settings. Everything stays readable without it. This
                                    browser stays unlocked.
                                </text>
                            }
                        </div>
                    </EditForm>
                </div>
            </div>

            @if (Gate.IsPasswordSet)
            {
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Remove the password</h5>
                        <EditForm Model="RemoveModel" FormName="remove-password" OnValidSubmit="RemoveAsync">
                            <DataAnnotationsValidator />
                            @if (_removeError is not null)
                            {
                                <div class="alert alert-danger py-2">@_removeError</div>
                            }
                            <div class="mb-3">
                                <label class="form-label" for="remove-current-password">Current password</label>
                                <input id="remove-current-password" type="password" name="RemoveModel.Current"
                                       class="form-control form-control-sm" autocomplete="current-password" />
                                <ValidationMessage For="() => RemoveModel!.Current" />
                            </div>
                            <button type="submit" class="btn btn-outline-danger btn-sm">Remove password</button>
                            <div class="form-text">
                                Everything goes back to being unlocked for everyone who can reach
                                HostPinger.
                            </div>
                        </EditForm>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    // Bounded above because every character is hashed, and not bounded below beyond having to be
    // there at all: how strong the password needs to be is the operator's call, not this page's.
    private const int MaximumLength = 128;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /*
     * The posted forms, which must not carry initializers. The framework assigns both while
     * setting parameters — the one the request posted, and the other one null — so an initializer
     * would run afterwards and throw away what was posted. OnInitialized puts an empty form back
     * for whichever of them was not posted. The fields are named after these properties, so what
     * the markup binds through has to be them and not tidier aliases for them.
     */
    [SupplyParameterFromForm(FormName = "change-password")]
    private ChangeForm? ChangeModel { get; set; }

    [SupplyParameterFromForm(FormName = "remove-password")]
    private RemoveForm? RemoveModel { get; set; }

    private string? _changeError;
    private string? _removeError;

    protected override void OnInitialized()
    {
        ChangeModel ??= new ChangeForm();
        RemoveModel ??= new RemoveForm();
    }

    private bool IsUnlocked => Gate.IsUnlocked(HttpContext?.User);

    private async Task ChangeAsync()
    {
        var form = ChangeModel!;

        // Read before the save, which is what makes it the answer to "was there one before this".
        var wasSet = Gate.IsPasswordSet;
        if (wasSet)
        {
            // The same guess against the same password as the unlock page, so it is counted and
            // logged the same way — this form must not be the cheap way round the wait that one
            // imposes. A mismatched confirmation below is a typo rather than an attempt, and is
            // deliberately not counted.
            var attempt = Attempts.Verify(HttpContext?.Connection.RemoteIpAddress, form.Current);
            if (!attempt.IsAccepted)
            {
                if (attempt.Result == PasswordAttemptResult.Wrong)
                {
                    Logger.LogWarning(
                        "Failed password change from {Address}: the current password was wrong.",
                        RequestOrigin.Describe(HttpContext));
                }

                _changeError = attempt.WaitMessage ?? "That is not the current password.";
                return;
            }
        }

        if (form.New != form.Confirm)
        {
            _changeError = "The two new passwords do not match.";
            return;
        }

        var hash = PasswordHash.Hash(form.New);
        await SettingsStore.SavePasswordHashAsync(hash);

        // Before redirecting, so the page this lands on draws the password that now exists rather
        // than the state it is replacing.
        await Gate.WaitForSaveAsync(hash);

        Logger.LogInformation(
            "Password {Action} from {Address}.",
            wasSet ? "changed" : "set",
            RequestOrigin.Describe(HttpContext));

        // Stamped from the hash just written rather than the stored one: the configuration reload
        // is asynchronous, so reading it back here would still give the password that was replaced
        // and lock this browser out as soon as the reload caught up.
        await HttpContext!.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme,
            Gate.CreatePrincipal(hash),
            new AuthenticationProperties { IsPersistent = false });

        Navigation.NavigateTo("configuration");
    }

    private async Task RemoveAsync()
    {
        var attempt = Attempts.Verify(HttpContext?.Connection.RemoteIpAddress, RemoveModel!.Current);
        if (!attempt.IsAccepted)
        {
            if (attempt.Result == PasswordAttemptResult.Wrong)
            {
                Logger.LogWarning(
                    "Failed password removal from {Address}: the current password was wrong.",
                    RequestOrigin.Describe(HttpContext));
            }

            _removeError = attempt.WaitMessage ?? "That is not the current password.";
            return;
        }

        await SettingsStore.SavePasswordHashAsync(null);
        await Gate.WaitForSaveAsync(null);

        // Worth a line of its own at least as much as the failures are: it is the moment the
        // service stopped asking anyone for anything.
        Logger.LogWarning("Password removed from {Address}; nothing is locked now.",
            RequestOrigin.Describe(HttpContext));

        // Nothing is locked without a password, so the cookie has nothing left to say.
        await HttpContext!.SignOutAsync(CookieAuthenticationDefaults.AuthenticationScheme);

        Navigation.NavigateTo("configuration");
    }

    private sealed class ChangeForm
    {
        /// <summary>
        /// Not annotated: it is only asked for once a password is set, and a field the page does
        /// not render cannot be required of it. <see cref="ChangeAsync"/> checks it instead.
        /// </summary>
        public string Current { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter a new password.")]
        [StringLength(MaximumLength, ErrorMessage = "Use no more than 128 characters.")]
        public string New { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter the new password again.")]
        public string Confirm { get; set; } = string.Empty;
    }

    private sealed class RemoveForm
    {
        [Required(ErrorMessage = "Enter the current password.")]
        public string Current { get; set; } = string.Empty;
    }
}
