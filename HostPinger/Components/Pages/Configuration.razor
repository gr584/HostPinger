@page "/configuration"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Net
@using HostPinger.Core.Options
@using HostPinger.Core.Services
@using HostPinger.Security
@using Microsoft.AspNetCore.Components.Authorization
@inject DatabaseReads Reads
@inject PingerPaths Paths
@inject UserSettingsStore SettingsStore
@inject PasswordGate Gate
@inject PasswordAttempts Attempts
@inject IHttpContextAccessor HttpContextAccessor
@inject LockPrompt Prompt
@inject DatabaseBackup Backup
@inject BackupDownloadTokens Tokens
@inject IJSRuntime JS
@inject ILogger<Configuration> Logger
@implements IDisposable

<PageTitle>HostPinger - Configuration</PageTitle>

<h1>Configuration</h1>

@if (!_isUnlocked)
{
    <p class="text-muted">
        HostPinger is locked, so the settings below can be read but not changed.
        <button type="button" class="btn btn-link btn-sm p-0 align-baseline"
                @onclick="() => Prompt.Request()">Unlock</button> to edit them.
    </p>
}

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">Database</h5>
        <EditForm Model="_databaseForm" OnValidSubmit="SaveDatabaseAsync">
            <DataAnnotationsValidator />
            <dl class="config-list">
                <dt>Path</dt>
                <dd><code class="config-path">@Paths.DatabasePath</code></dd>

                <dt>Current size</dt>
                <dd>
                    <span class="config-value">@SizeText</span>
                    <span class="text-muted ms-2">@GrowthText</span>
                </dd>

                <dt><label for="max-db-size">Maximum size</label></dt>
                <dd>
                    <div class="input-group input-group-sm config-input">
                        <InputNumber id="max-db-size" class="form-control" disabled="@(!_isUnlocked)"
                                     @bind-Value="_databaseForm.MaxDatabaseSizeMb" />
                        <span class="input-group-text">MB</span>
                        <button type="submit" class="btn btn-primary" disabled="@(!_isUnlocked)">Save</button>
                    </div>
                    <ValidationMessage For="() => _databaseForm.MaxDatabaseSizeMb" />
                    <div class="form-text">
                        The oldest ping attempts and resolver errors are pruned once the file grows
                        past this. 0 disables pruning, though resolver errors are still dropped
                        once they are 30 days old.
                        @if (_databaseStatus is not null)
                        {
                            <span class="@StatusClass(_isDatabaseSaveRefused)">@_databaseStatus</span>
                        }
                    </div>
                </dd>

                <dt>Estimated capacity</dt>
                <dd>@CapacityText</dd>

                <dt>Backup</dt>
                <dd>
                    <button type="button" class="btn btn-outline-primary btn-sm" disabled="@(!_isUnlocked)"
                            @onclick="RequestDownloadAsync">Download backup</button>
                    <div class="form-text">
                        A compacted snapshot of the whole database: hosts, history, settings and
                        the password, if one is set, all travel with it.
                        @if (_backupStatus is not null)
                        {
                            <span class="config-refused">@_backupStatus</span>
                        }
                    </div>
                </dd>

                <dt>Restore</dt>
                <dd>
                    @*
                        The visible control is the label, styled to sit beside Download backup;
                        clicking a label opens its input's file picker, which is what lets the
                        input itself stay hidden without a line of script. Hidden but always in
                        the DOM: the browser keeps the chosen file on the input element itself,
                        and reading it on confirm goes back to that element — unmounting it is
                        how an upload loses its file. Cancelling re-keys the input instead, which
                        recreates it empty and lets the browser drop the choice. Choosing a file
                        opens the confirmation below.

                        With a password set, the button opens that overlay first instead, to ask
                        for the password before a file is chosen; the overlay then offers a label
                        for the same input.
                    *@
                    <InputFile id="restore-file" @key="_restoreInputKey" OnChange="OnRestoreFileSelected"
                               disabled="@(!_isUnlocked)" class="d-none" />
                    @if (Gate.IsPasswordSet)
                    {
                        <button type="button" class="btn btn-outline-primary btn-sm" disabled="@(!_isUnlocked)"
                                @onclick="RequestRestoreAsync">Restore backup…</button>
                    }
                    else
                    {
                        <label for="restore-file" role="button"
                               class="btn btn-outline-primary btn-sm@(_isUnlocked ? null : " disabled")">Restore backup…</label>
                    }
                    <div class="form-text">
                        Uploading a backup replaces the current database after a confirmation.
                        @if (_restoreStatus is not null)
                        {
                            <span class="config-refused">@_restoreStatus</span>
                        }
                    </div>
                </dd>
            </dl>
        </EditForm>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <EditForm Model="_pingerForm" OnValidSubmit="SavePingerAsync">
            <DataAnnotationsValidator />
            @*
                The buttons act on all four settings at once, so they sit on the title row rather
                than against any one of them.
            *@
            <div class="config-header">
                <h5 class="card-title">Pinger config</h5>
                <div class="config-actions">
                    <button type="button" class="btn btn-outline-danger btn-sm" disabled="@(!HasPingerChanges)" @onclick="RevertPinger">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm" disabled="@(!_isUnlocked || !HasPingerChanges)">Save</button>
                </div>
            </div>
            <dl class="config-list">
                <dt><label for="ping-interval">Ping interval</label></dt>
                <dd>
                    <div class="input-group input-group-sm config-input">
                        <InputNumber id="ping-interval" class="form-control" disabled="@(!_isUnlocked)"
                                     @bind-Value="_pingerForm.IntervalSeconds" />
                        <span class="input-group-text">seconds</span>
                    </div>
                    <ValidationMessage For="() => _pingerForm.IntervalSeconds" />
                    <div class="form-text">How often every enabled host is pinged.</div>
                </dd>

                <dt><label for="ping-timeout">Timeout</label></dt>
                <dd>
                    <div class="input-group input-group-sm config-input">
                        <InputNumber id="ping-timeout" class="form-control" disabled="@(!_isUnlocked)"
                                     @bind-Value="_pingerForm.TimeoutSeconds" />
                        <span class="input-group-text">seconds</span>
                    </div>
                    <ValidationMessage For="() => _pingerForm.TimeoutSeconds" />
                    <div class="form-text">How long to wait for a reply before recording the host as down.</div>
                </dd>

                <dt><label for="resolve-timeout">Resolve timeout</label></dt>
                <dd>
                    <div class="input-group input-group-sm config-input">
                        <InputNumber id="resolve-timeout" class="form-control" disabled="@(!_isUnlocked)"
                                     @bind-Value="_pingerForm.ResolveTimeoutSeconds" />
                        <span class="input-group-text">seconds</span>
                    </div>
                    <ValidationMessage For="() => _pingerForm.ResolveTimeoutSeconds" />
                    <div class="form-text">
                        How long to wait for a host name to become an address. A name that does not
                        resolve in time is skipped for that round rather than recorded as down, and
                        the failure is listed under <a href="resolver-errors">Resolver errors</a>.
                    </div>
                </dd>

                <dt><label for="retry-attempts">Retry attempts</label></dt>
                <dd>
                    <div class="input-group input-group-sm config-input">
                        <InputNumber id="retry-attempts" class="form-control" disabled="@(!_isUnlocked)"
                                     @bind-Value="_pingerForm.RetryAttempts" />
                        <span class="input-group-text">attempts</span>
                    </div>
                    <ValidationMessage For="() => _pingerForm.RetryAttempts" />
                    <div class="form-text">
                        How many times a host that misses a ping is retried before it counts as
                        down. It shows as retrying while it has attempts left, and a run of misses
                        that never uses them up is not reported as downtime; 0 makes the first
                        missed ping count.
                        @if (_pingerStatus is not null)
                        {
                            <span class="@StatusClass(_isPingerSaveRefused)">@_pingerStatus</span>
                        }
                    </div>
                </dd>
            </dl>
        </EditForm>
    </div>
</div>

@*
    The password itself is set on its own page rather than here: signing this browser in afterwards
    writes a cookie, and this page is a circuit with no request left to write one on.
*@
<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title">Security</h5>
        @if (Gate.IsPasswordSet)
        {
            <p class="mb-2">
                A password is needed to add, edit, remove and pause hosts and to change these
                settings. Everything else stays readable without it.
            </p>
            @if (_isUnlocked)
            {
                <a class="btn btn-outline-primary btn-sm" href="password">Change or remove password</a>
            }
            else
            {
                <button type="button" class="btn btn-outline-primary btn-sm"
                        @onclick="@(() => Prompt.Request("/password"))">Unlock to change it</button>
            }
        }
        else
        {
            <p class="mb-2">
                No password is set: anyone who can reach HostPinger can add, edit, remove and pause
                hosts and change every setting on this page.
            </p>
            <a class="btn btn-primary btn-sm" href="password">Set a password</a>
        }
    </div>
</div>

@if (_confirming != Confirming.Nothing)
{
    @*
        Bootstrap's modal markup driven from here, the way the host form and the unlock overlay
        do it. Unlike the unlock overlay's form, this one is handled here rather than posted:
        nothing it does writes a cookie, so the circuit can check the password itself. The page
        stays where it is, with the chosen file still on its input, while it is open.
    *@
    <div class="modal d-block" tabindex="-1" aria-modal="true" role="dialog" @ref="_dialog"
         @onkeydown="OnDialogKeyDown" @onclick="OnOverlayClick" @onmousedown="() => _pressedInsideDialog = false">
        <div class="modal-dialog modal-dialog-centered">
            @*
                The content box stops both events rather than the dialog box, because
                modal-dialog-centered stretches that one to the full height of the overlay — a
                click above or below the form has to reach the overlay to count as a click away.
            *@
            <div class="modal-content" @onclick:stopPropagation
                 @onmousedown="() => _pressedInsideDialog = true" @onmousedown:stopPropagation>
                <form @onsubmit="SubmitDialogAsync">
                    <div class="modal-header">
                        <h5 class="modal-title">@(IsDownloading ? "Download backup" : "Restore backup")</h5>
                        <button type="button" class="btn-close" aria-label="Close" disabled="@_isRestoring"
                                @onclick="CancelDialog"></button>
                    </div>
                    <div class="modal-body">
                        @if (DialogNotice is not null)
                        {
                            <div class="alert alert-danger py-2">@DialogNotice</div>
                        }
                        @switch (_confirming)
                        {
                            case Confirming.Download:
                                <p>
                                    The backup carries the password's hash along with everything
                                    else, so downloading one takes the current password, even in an
                                    unlocked browser.
                                </p>
                                break;
                            case Confirming.RestorePassword:
                                <p>
                                    A restore puts the backup's password, or the lack of one, in place
                                    of this one, so it takes the current password, even in an unlocked
                                    browser.
                                </p>
                                break;
                            case Confirming.RestoreFile:
                                <p class="mb-0">
                                    Choose the backup to restore. Nothing is replaced until you have
                                    confirmed it.
                                </p>
                                break;
                            case Confirming.Restored:
                                <div class="alert @(_isRestoreRefused ? "alert-danger" : "alert-success") mb-0"
                                     role="status">@_restoreResult</div>
                                break;
                            case Confirming.Preparing:
                            case Confirming.Restore when _isRestoring:
                                @*
                                    A fraction for the steps that have one, and otherwise a bar that
                                    moves without saying how far, for the ones SQLite gives no measure
                                    of: checking a backup, and migrating and swapping it in.
                                *@
                                <div class="d-flex justify-content-between mb-2">
                                    <span>@_progressLabel</span>
                                    @if (ProgressPercent is { } percent)
                                    {
                                        <span>@percent%</span>
                                    }
                                </div>
                                <div class="progress" role="progressbar" aria-label="@_progressLabel"
                                     aria-valuemin="0" aria-valuemax="100" aria-valuenow="@ProgressPercent">
                                    <div class="progress-bar@(ProgressPercent is null ? " progress-bar-striped progress-bar-animated" : null)"
                                         style="width: @(ProgressPercent ?? 100)%"></div>
                                </div>
                                break;
                            default:
                                <p class="text-danger mb-0">
                                    Restore <code>@_restoreFile?.Name</code>? It replaces everything —
                                    hosts, history and settings, and the backup's password (or lack of
                                    one) will apply, which can lock this browser out or unlock the
                                    application. The current database is kept as
                                    <code>@Path.GetFileName(Backup.PreRestorePath)</code>.
                                </p>
                                break;
                        }
                        @if (AsksPassword)
                        {
                            <label class="form-label" for="backup-current-password">Current password</label>
                            <input id="backup-current-password" type="password" class="form-control form-control-sm"
                                   autocomplete="current-password"
                                   @bind="_password" @bind:event="oninput" @ref="_passwordInput" />
                        }
                    </div>
                    <div class="modal-footer">
                        @if (_confirming != Confirming.Restored)
                        {
                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@_isRestoring"
                                    @onclick="CancelDialog">Cancel</button>
                        }
                        @*
                            Held back while a wait stands, as the unlock overlay's button is: nothing
                            typed then would be looked at. Disabling it also stops Enter submitting.
                        *@
                        @switch (_confirming)
                        {
                            case Confirming.Download:
                                <button type="submit" class="btn btn-primary btn-sm" disabled="@IsWaiting">Download</button>
                                break;
                            case Confirming.RestorePassword:
                                <button type="submit" class="btn btn-primary btn-sm" disabled="@IsWaiting">Continue</button>
                                break;
                            case Confirming.RestoreFile:
                                @* The page's own hidden input, so the chosen file stays put; see there. *@
                                <label for="restore-file" role="button" class="btn btn-primary btn-sm">Choose file…</label>
                                break;
                            case Confirming.Restored:
                                <button type="button" class="btn btn-primary btn-sm" @onclick="CloseDialog">Close</button>
                                break;
                            case Confirming.Preparing:
                                break;
                            default:
                                <button type="submit" class="btn btn-danger btn-sm"
                                        disabled="@_isRestoring">@(_isRestoring ? "Restoring…" : "Confirm restore")</button>
                                break;
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="modal-backdrop show"></div>
}

@code {
    // Upper bounds the form accepts; the pinger clamps to the same interval and timeout ceilings.
    private const int IntervalUpperBoundSeconds = 86_400;
    private const int TimeoutUpperBoundSeconds = 60;
    private const int SizeUpperBoundMb = 1_000_000;

    // A thousand retries is over eight hours before a host counts as down at the default interval,
    // which is well past useful.
    private const int RetryAttemptsUpperBound = 1_000;

    // A sanity bound on a restore upload, not the real guard: free disk space is checked before
    // the upload starts, and a backup larger than this install's size limit is legitimate — it
    // came from an install with a bigger one, and the pruner trims it after the restore.
    private const long MaxRestoreUploadBytes = 16L * 1024 * 1024 * 1024;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private readonly DatabaseForm _databaseForm = new();
    private readonly PingerForm _pingerForm = new();
    private readonly PageReads _reads = new();
    private readonly CancellationTokenSource _cts = new();

    private DatabaseStats? _stats;
    private string? _databaseStatus;
    private string? _pingerStatus;

    // The backup status only ever reports a refusal — a download that starts is its own feedback.
    private string? _backupStatus;

    // Beside the restore control, which only ever reports the locked refusal: whatever comes of
    // confirming a restore is said in the overlay instead, in the step after the confirmation.
    private string? _restoreStatus;
    private string? _restoreResult;
    private bool _isRestoreRefused;

    // The chosen file, held while the confirmation is on screen. Confirming is a separate click
    // from choosing, because what follows replaces the database.
    private IBrowserFile? _restoreFile;
    private bool _isRestoring;

    // Replaced to recreate the restore input. The file lives on the browser's input element, so
    // the element has to survive until the upload has been read, and be rebuilt to be cleared.
    private object _restoreInputKey = new();

    // What a long step in the overlay is doing, and how far it has got as a fraction: null for a
    // step that gives no measure of that.
    private string? _progressLabel;
    private double? _progress;

    // The snapshot being written for a download, cancelled when its overlay is, or when the page goes.
    private CancellationTokenSource? _preparation;

    // The page's script, imported the first time a download starts.
    private IJSObjectReference? _module;

    // The overlay that confirms a download or a restore, and what it is confirming.
    private Confirming _confirming;
    private ElementReference _dialog;
    private ElementReference _passwordInput;
    private bool _pressedInsideDialog;
    private bool _focusDialog;
    private string? _dialogError;

    // Whether the current password has been given for the restore under way, which it is before a
    // file is chosen. Forgotten with the chosen file, so it never carries over to the next restore.
    private bool _restorePasswordGiven;

    // What is typed in the overlay's password box. Emptied after every attempt, right or wrong, so
    // a password is held here no longer than it takes to check it.
    private string _password = string.Empty;

    // When the wait a run of wrong passwords has earned runs out, and null while none stands. Kept
    // across closing and reopening the overlay, as the unlock overlay keeps its own.
    private DateTimeOffset? _waitUntil;
    private bool _isCountingDown;

    // Whether the message beside each Save is a refusal rather than a confirmation, which is only
    // the locked case: the buttons are disabled then, so it takes a lock arriving between the last
    // render and the click.
    private bool _isDatabaseSaveRefused;
    private bool _isPingerSaveRefused;

    // Whether this browser may save anything, re-read on the same timer as the settings themselves
    // so a password set or removed elsewhere reaches the controls on the next refresh.
    private bool _isUnlocked;

    // The settings the running application is using. Kept alongside the form values so an edit
    // that has not been saved yet cannot skew the size projections below it.
    private int _effectiveIntervalSeconds;
    private int _effectiveTimeoutSeconds;
    private int _effectiveResolveTimeoutSeconds;
    private int _effectiveRetryAttempts;
    private int _effectiveMaxDatabaseSizeMb;

    protected override async Task OnInitializedAsync()
    {
        SyncFromConfiguration();
        _isUnlocked = await IsUnlockedAsync();
        await LoadStatsAsync();
        _ = AutoRefreshAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Focusing puts the keyboard inside the overlay, which is what lets Escape reach
        // OnDialogKeyDown: the password box when there is one, the overlay itself otherwise.
        if (_focusDialog && _confirming != Confirming.Nothing)
        {
            _focusDialog = false;
            await (AsksPassword ? _passwordInput : _dialog).FocusAsync();
        }

        // Started from a render that has happened in a browser, as the unlock overlay starts its
        // own; see CountDownAsync.
        if (IsWaiting && !_isCountingDown)
        {
            _isCountingDown = true;
            _ = CountDownAsync();
        }
    }

    /// <summary>
    /// Whether this browser may change settings. Asked again inside both save handlers rather than
    /// trusted from the last render: disabling a button is a courtesy to the reader, and this is
    /// the answer that decides whether anything is written.
    /// </summary>
    private async Task<bool> IsUnlockedAsync()
    {
        var user = AuthenticationState is null ? null : (await AuthenticationState).User;
        return Gate.IsUnlocked(user);
    }

    private async Task AutoRefreshAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                SyncFromConfiguration();
                _isUnlocked = await IsUnlockedAsync();
                await LoadStatsAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    /// <summary>
    /// Picks up settings changed elsewhere — another browser tab, or appsettings.json by hand.
    /// A field the user has started editing is left alone.
    /// </summary>
    private void SyncFromConfiguration()
    {
        var options = SettingsStore.CurrentPinger;
        if (_databaseForm.MaxDatabaseSizeMb == _effectiveMaxDatabaseSizeMb)
        {
            _databaseForm.MaxDatabaseSizeMb = options.MaxDatabaseSizeMb;
        }

        if (_pingerForm.IntervalSeconds == _effectiveIntervalSeconds)
        {
            _pingerForm.IntervalSeconds = options.IntervalSeconds;
        }

        if (_pingerForm.TimeoutSeconds == _effectiveTimeoutSeconds)
        {
            _pingerForm.TimeoutSeconds = options.TimeoutSeconds;
        }

        if (_pingerForm.ResolveTimeoutSeconds == _effectiveResolveTimeoutSeconds)
        {
            _pingerForm.ResolveTimeoutSeconds = options.ResolveTimeoutSeconds;
        }

        if (_pingerForm.RetryAttempts == _effectiveRetryAttempts)
        {
            _pingerForm.RetryAttempts = options.RetryAttempts;
        }

        _effectiveMaxDatabaseSizeMb = options.MaxDatabaseSizeMb;
        _effectiveIntervalSeconds = options.IntervalSeconds;
        _effectiveTimeoutSeconds = options.TimeoutSeconds;
        _effectiveResolveTimeoutSeconds = options.ResolveTimeoutSeconds;
        _effectiveRetryAttempts = options.RetryAttempts;
    }

    /// <summary>
    /// Reads the figures under the database and pinger sections: pragmas and index seeks, the
    /// attempt count among them (see <see cref="DatabaseStats.CountAttemptsAsync" />), so the whole
    /// set is cheap enough to take again on every refresh and on opening the page.
    /// </summary>
    private async Task LoadStatsAsync()
    {
        // Taken here, on the circuit, because the read below is not; see PageReads.
        var options = new PingerOptions
        {
            IntervalSeconds = _effectiveIntervalSeconds,
            MaxDatabaseSizeMb = _effectiveMaxDatabaseSizeMb,
        };

        var stats = await _reads.ReadAsync(
            cancellationToken => Reads.ReadStatsAsync(options, cancellationToken),
            _cts.Token);

        // Overtaken by a read sent after it, which has already put something newer on screen.
        if (stats is null)
        {
            return;
        }

        _stats = stats;
    }

    private async Task SaveDatabaseAsync()
    {
        if (!await IsUnlockedAsync())
        {
            _databaseStatus = "HostPinger is locked — unlock it to change this.";
            _isDatabaseSaveRefused = true;
            _isUnlocked = false;
            return;
        }

        await SettingsStore.SaveAsync(
            new PingerSettingsUpdate { MaxDatabaseSizeMb = _databaseForm.MaxDatabaseSizeMb },
            _cts.Token);

        // The save is in force the moment it returns, so re-reading the store is all it takes
        // for the projections below to use it.
        SyncFromConfiguration();
        _databaseStatus = "Saved — applied after the next ping round.";
        _isDatabaseSaveRefused = false;
        await LoadStatsAsync();
    }

    /// <summary>
    /// Whether the pinger form holds an edit that has not been saved, which is what the Save and
    /// Cancel buttons key off. The comparison is the one <see cref="SyncFromConfiguration" /> makes
    /// per field: a value that still matches the running configuration is not an edit.
    /// </summary>
    private bool HasPingerChanges =>
        _pingerForm.IntervalSeconds != _effectiveIntervalSeconds
        || _pingerForm.TimeoutSeconds != _effectiveTimeoutSeconds
        || _pingerForm.ResolveTimeoutSeconds != _effectiveResolveTimeoutSeconds
        || _pingerForm.RetryAttempts != _effectiveRetryAttempts;

    private void RevertPinger()
    {
        _pingerForm.IntervalSeconds = _effectiveIntervalSeconds;
        _pingerForm.TimeoutSeconds = _effectiveTimeoutSeconds;
        _pingerForm.ResolveTimeoutSeconds = _effectiveResolveTimeoutSeconds;
        _pingerForm.RetryAttempts = _effectiveRetryAttempts;
    }

    private async Task SavePingerAsync()
    {
        if (!await IsUnlockedAsync())
        {
            _pingerStatus = "HostPinger is locked — unlock it to change these.";
            _isPingerSaveRefused = true;
            _isUnlocked = false;
            return;
        }

        await SettingsStore.SaveAsync(
            new PingerSettingsUpdate
            {
                IntervalSeconds = _pingerForm.IntervalSeconds,
                TimeoutSeconds = _pingerForm.TimeoutSeconds,
                ResolveTimeoutSeconds = _pingerForm.ResolveTimeoutSeconds,
                RetryAttempts = _pingerForm.RetryAttempts,
            },
            _cts.Token);

        // The save is in force the moment it returns, so re-reading the store catches it up.
        SyncFromConfiguration();
        _pingerStatus = "Saved — applied from the next ping round.";
        _isPingerSaveRefused = false;
        await LoadStatsAsync();
    }

    /// <summary>
    /// The address this page's clicks arrive from, which is what a guess typed here is counted
    /// against and what the log names.
    /// </summary>
    /// <remarks>
    /// A circuit's events come with no request of their own, so this is the connection the circuit
    /// runs over: the browser's socket, opened from the same address as its unlock, and so counted
    /// on the same tally. Null if the connection has no request behind it any more, which counts
    /// against the one tally <see cref="PasswordAttempts"/> keeps for everything without an address.
    /// </remarks>
    private IPAddress? Origin => HttpContextAccessor.HttpContext?.Connection.RemoteIpAddress;

    /// <summary>
    /// Checks the password typed in the overlay for <paramref name="action"/>, and whether it may go
    /// ahead — which it always may while no password is set. When it may not, the overlay stays
    /// open and says why.
    /// </summary>
    /// <remarks>
    /// Asked even though this browser is unlocked, for the reason the Password page asks before a
    /// change: a browser left open and walked away from must not be enough to take the password
    /// over. A backup carries its hash away, and a restore puts the backup's password, or none, in
    /// its place. Through <see cref="PasswordAttempts"/>, so a wrong guess here waits and is logged
    /// the same as one at the unlock overlay, and this is no way round that one's wait.
    /// </remarks>
    private bool HasCurrentPassword(string action)
    {
        var typed = _password;
        _password = string.Empty;
        if (!Gate.IsPasswordSet)
        {
            return true;
        }

        var attempt = Attempts.Verify(Origin, typed);
        if (attempt.IsAccepted)
        {
            _waitUntil = null;
            return true;
        }

        // An empty box is not counted as a guess, and is not logged as one either.
        if (attempt.Result == PasswordAttemptResult.Wrong && typed.Length > 0)
        {
            Logger.LogWarning(
                "Failed {Action} from {Address}: the current password was wrong.",
                action,
                RequestOrigin.Describe(Origin));
        }

        _waitUntil = attempt.Wait > TimeSpan.Zero ? DateTimeOffset.UtcNow + attempt.Wait : null;
        _dialogError = typed.Length > 0 ? "That is not the current password." : "Enter the current password.";
        _focusDialog = true;
        return false;
    }

    /// <summary>
    /// Asks for the current password before a download, and goes straight on to writing the
    /// snapshot when there is none to ask for.
    /// </summary>
    private async Task RequestDownloadAsync()
    {
        // A locked browser goes straight through too, to be turned away there: there is no point
        // asking it for a password first.
        if (Gate.IsPasswordSet && await IsUnlockedAsync())
        {
            OpenDialog(Confirming.Download);
            return;
        }

        await DownloadBackupAsync();
    }

    private async Task DownloadBackupAsync()
    {
        if (!await IsUnlockedAsync())
        {
            CloseDialog();
            _backupStatus = "HostPinger is locked — unlock it to download a backup.";
            _isUnlocked = false;
            return;
        }

        // Before anything is written, and so before the token is issued: the endpoint that serves
        // the file needs nothing more than the token and the unlock.
        if (!HasCurrentPassword("backup download"))
        {
            return;
        }

        // The snapshot lands beside the database before the browser starts pulling it, so the
        // disk has to hold a second copy of the file for the duration of the download.
        await LoadStatsAsync();
        if (_stats is { } stats
            && Backup.AvailableFreeBytes() < stats.SizeBytes + DatabaseBackup.FreeSpaceMarginBytes)
        {
            CloseDialog();
            _backupStatus = "Not enough free disk space beside the database to write the snapshot.";
            return;
        }

        _backupStatus = null;
        using var preparation = CancellationTokenSource.CreateLinkedTokenSource(_cts.Token);
        _preparation = preparation;
        OpenDialog(Confirming.Preparing);
        ShowStep("Preparing the backup…", 0);

        string? snapshotPath = null;
        string? failure = null;
        try
        {
            // Progress<T> hands each report to the circuit, as the page's own events are.
            snapshotPath = await Backup.CreateSnapshotAsync(
                new Progress<double>(fraction =>
                {
                    if (!preparation.IsCancellationRequested)
                    {
                        ShowProgress(fraction);
                    }
                }),
                preparation.Token);
        }
        catch (OperationCanceledException)
        {
        }
        catch (IOException ex)
        {
            failure = ex.Message;
        }
        finally
        {
            if (_preparation == preparation)
            {
                _preparation = null;
            }
        }

        // Cancelled from the overlay, which closed then and may have been opened again since, or
        // the page is gone. A copy that finished regardless is deleted here; one that was stopped
        // partway, CreateSnapshotAsync has deleted already.
        if (preparation.IsCancellationRequested)
        {
            if (snapshotPath is not null)
            {
                File.Delete(snapshotPath);
            }

            return;
        }

        CloseDialog();
        if (snapshotPath is null)
        {
            _backupStatus = $"The backup could not be written: {failure}";
            return;
        }

        Logger.LogInformation("Backup downloaded from {Address}.", RequestOrigin.Describe(Origin));

        // Fetched by the browser rather than over the circuit, through a download link rather
        // than a navigation; the module says why. If the browser never asks, because the circuit
        // went before it could be told, the token expires and deletes the snapshot.
        var address = $"database-backup?token={Tokens.Issue(snapshotPath)}";
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Configuration.razor.js");
            await _module.InvokeVoidAsync("download", address);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException or ObjectDisposedException)
        {
        }
    }

    /// <summary>
    /// Starts a restore with the current password, before any file is chosen, so that a refusal
    /// costs nobody a trip through the file picker. Only offered while a password is set; without
    /// one, the page's own label goes straight to the picker.
    /// </summary>
    private async Task RequestRestoreAsync()
    {
        if (!await IsUnlockedAsync())
        {
            RefuseRestoreAsLocked();
            return;
        }

        CancelRestore();
        OpenDialog(Confirming.RestorePassword);
    }

    private async Task GiveRestorePasswordAsync()
    {
        if (!await IsUnlockedAsync())
        {
            RefuseRestoreAsLocked();
            return;
        }

        if (!HasCurrentPassword("restore"))
        {
            return;
        }

        // Straight on to the confirmation when a file is already chosen, which is the case when
        // the confirmation itself sent the overlay back here; see ConfirmRestoreAsync.
        _restorePasswordGiven = true;
        OpenDialog(_restoreFile is null ? Confirming.RestoreFile : Confirming.Restore);
    }

    private void OnRestoreFileSelected(InputFileChangeEventArgs e)
    {
        _restoreFile = e.File;
        _restoreStatus = null;
        OpenDialog(Confirming.Restore);
    }

    private void CancelRestore()
    {
        _restoreFile = null;
        _restorePasswordGiven = false;
        _restoreInputKey = new object();
    }

    private void RefuseRestoreAsLocked()
    {
        _restoreStatus = "HostPinger is locked — unlock it to restore a backup.";
        _isRestoreRefused = true;
        _isUnlocked = false;
        CancelRestore();
        CloseDialog();
    }

    private void OpenDialog(Confirming what)
    {
        _confirming = what;
        _password = string.Empty;
        _dialogError = null;
        _pressedInsideDialog = false;
        _focusDialog = true;

        // A wait that has run out since the overlay last said so has nothing left to say.
        if (!IsWaiting)
        {
            _waitUntil = null;
        }
    }

    private void CloseDialog()
    {
        _confirming = Confirming.Nothing;
        _password = string.Empty;
        _dialogError = null;
    }

    /// <summary>Closes the overlay without doing what it was opened for.</summary>
    private void CancelDialog()
    {
        if (_confirming == Confirming.Preparing)
        {
            _preparation?.Cancel();
        }
        else if (_confirming != Confirming.Download)
        {
            CancelRestore();
        }

        CloseDialog();
    }

    // Choosing a file is the label's doing rather than a submit, and the result has only Close, so
    // neither step has anything here.
    private Task SubmitDialogAsync() => _confirming switch
    {
        Confirming.Download => DownloadBackupAsync(),
        Confirming.RestorePassword => GiveRestorePasswordAsync(),
        Confirming.Restore => ConfirmRestoreAsync(),
        _ => Task.CompletedTask,
    };

    /// <summary>Whether the step on screen asks for the current password.</summary>
    private bool AsksPassword => _confirming is Confirming.Download or Confirming.RestorePassword;

    private bool IsDownloading => _confirming is Confirming.Download or Confirming.Preparing;

    /// <summary>Starts a long step's bar: at <paramref name="progress"/>, or moving without a measure when null.</summary>
    private void ShowStep(string label, double? progress)
    {
        _progressLabel = label;
        _progress = progress;
        StateHasChanged();
    }

    /// <summary>Moves the bar on, drawing it again only when the percentage it shows has changed.</summary>
    private void ShowProgress(double fraction)
    {
        var shown = ProgressPercent;
        _progress = fraction;
        if (ProgressPercent != shown)
        {
            StateHasChanged();
        }
    }

    private int? ProgressPercent => _progress is { } fraction ? (int)(fraction * 100) : null;

    private void OnDialogKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && !_isRestoring)
        {
            CancelDialog();
        }
    }

    /// <summary>
    /// Cancels on a click away. Dragging a text selection out of the field also raises a click on
    /// the overlay, so a press that started inside it is not one. A snapshot being written is
    /// cancelled only on purpose, with Cancel or Escape: a stray click would throw away a copy
    /// that may have taken a while.
    /// </summary>
    private void OnOverlayClick()
    {
        if (!_pressedInsideDialog && !_isRestoring && _confirming != Confirming.Preparing)
        {
            CancelDialog();
        }
    }

    /// <summary>
    /// Redraws the overlay once a second for as long as a wait stands, the way the unlock overlay
    /// counts its own down, which hands the button back at the end of it. It runs for the whole
    /// wait rather than while the overlay is open, for the reason given there.
    /// </summary>
    private async Task CountDownAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (IsWaiting && await timer.WaitForNextTickAsync(_cts.Token))
            {
                if (_confirming != Confirming.Nothing)
                {
                    await InvokeAsync(StateHasChanged);
                }
            }

            // Once more for the render that has nothing left to count.
            _cts.Token.ThrowIfCancellationRequested();
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            _isCountingDown = false;
        }
    }

    /// <summary>What is left of the wait, zero once it has run out, and null while none stands.</summary>
    private TimeSpan? Remaining
    {
        get
        {
            if (_waitUntil is not { } until)
            {
                return null;
            }

            var left = until - DateTimeOffset.UtcNow;
            return left > TimeSpan.Zero ? left : TimeSpan.Zero;
        }
    }

    /// <summary>Whether a guess sent now would be turned away without being looked at.</summary>
    private bool IsWaiting => Remaining > TimeSpan.Zero;

    /// <summary>What the overlay says above its password box; a wait outranks the refusal it came with.</summary>
    private string? DialogNotice => Remaining is { } left ? PasswordAttempt.Waiting(left) : _dialogError;

    private async Task ConfirmRestoreAsync()
    {
        if (_restoreFile is not { } file)
        {
            CloseDialog();
            return;
        }

        if (!await IsUnlockedAsync())
        {
            RefuseRestoreAsLocked();
            return;
        }

        // The overlay's steps ask for the password before the file, but they are only what the
        // page offers: a file can be put on the hidden input without them, from the browser's
        // developer tools. This is what holds, and it holds before the upload, so nothing crosses
        // the network for a restore that would be turned away. The file stays chosen, and the
        // password step comes straight back here once it is given.
        if (Gate.IsPasswordSet && !_restorePasswordGiven)
        {
            OpenDialog(Confirming.RestorePassword);
            return;
        }

        if (Backup.AvailableFreeBytes() < file.Size + DatabaseBackup.FreeSpaceMarginBytes)
        {
            CancelRestore();
            ShowRestoreResult("Not enough free disk space beside the database to receive the file.", isRefused: true);
            return;
        }

        _isRestoring = true;
        ShowStep("Uploading the backup…", 0);
        try
        {
            var tempPath = Backup.CreateRestoreTempPath();
            try
            {
                await using (var target = new FileStream(
                    tempPath, FileMode.CreateNew, FileAccess.Write, FileShare.None, 81_920,
                    FileOptions.Asynchronous))
                {
                    // By hand rather than CopyToAsync, so the bar can follow the upload.
                    await using var source = file.OpenReadStream(MaxRestoreUploadBytes, _cts.Token);
                    var buffer = new byte[81_920];
                    long uploaded = 0;
                    int read;
                    while ((read = await source.ReadAsync(buffer, _cts.Token)) > 0)
                    {
                        await target.WriteAsync(buffer.AsMemory(0, read), _cts.Token);
                        uploaded += read;
                        ShowProgress(file.Size > 0 ? (double)uploaded / file.Size : 1);
                    }
                }

                ShowStep("Checking the backup…", null);
                if (await Backup.ValidateBackupAsync(tempPath, _cts.Token) is { } refusal)
                {
                    ShowRestoreResult(refusal, isRefused: true);
                    return;
                }

                ShowStep("Putting the backup in place…", null);
                await Backup.RestoreAsync(tempPath, _cts.Token);
            }
            finally
            {
                // The swap consumes the temp file; this catches every earlier exit — a failed
                // upload, a refused validation — where it would otherwise be left behind.
                File.Delete(tempPath);
            }
        }
        catch (Exception ex) when (ex is IOException or Microsoft.JSInterop.JSException)
        {
            // IOException is the file work on this side; JSException is the browser failing to
            // read what was chosen — a file changed or deleted since it was picked. Either is a
            // failed restore to report in the overlay, not a reason to tear the circuit down.
            ShowRestoreResult($"The restore failed: {ex.Message}", isRefused: true);
            return;
        }
        finally
        {
            // The overlay stays up, saying it is restoring, until here, and then says what came
            // of it.
            _isRestoring = false;
            CancelRestore();
        }

        // Before the reads below, so a refresh that renders while they run already shows it.
        ShowRestoreResult("Restored — the backup's hosts, history, settings and password now apply.", isRefused: false);

        // Beside the password changes in the log, since that is one of the things a restore is.
        Logger.LogInformation(
            "Backup restored from {Address}; its password, or the lack of one, is in force now.",
            RequestOrigin.Describe(Origin));

        // The restore is in force the moment it returns: the store already holds the backup's
        // settings, and the unlock answer below is already being judged against its password.
        SyncFromConfiguration();

        // The file underneath is the backup's now.
        await LoadStatsAsync();
        _isUnlocked = await IsUnlockedAsync();
    }

    /// <summary>Turns the overlay to what came of a confirmed restore, which it shows until closed.</summary>
    private void ShowRestoreResult(string result, bool isRefused)
    {
        _restoreResult = result;
        _isRestoreRefused = isRefused;
        OpenDialog(Confirming.Restored);
    }

    private static string StatusClass(bool isRefused) => isRefused ? "config-refused" : "config-saved";

    private string SizeText => _stats is { } stats ? FormatBytes(stats.SizeBytes) : "—";

    private string GrowthText => _stats?.GrowthBytesPerDay is double growth
        ? $"growing by ~{FormatBytes(growth)} per day"
        : "not enough data to estimate growth yet";

    private string CapacityText
    {
        get
        {
            if (_stats is not { } stats)
            {
                return "—";
            }

            if (stats.MaxSizeBytes <= 0)
            {
                return "Unlimited — pruning is disabled.";
            }

            return stats.CapacityDays is double days
                ? $"~{FormatDays(days)} of history at the current rate of growth"
                : "Not enough data to estimate yet.";
        }
    }

    private static string FormatBytes(double bytes)
    {
        string[] units = ["bytes", "KB", "MB", "GB", "TB"];
        var unit = 0;
        while (bytes >= 1024 && unit < units.Length - 1)
        {
            bytes /= 1024;
            unit++;
        }

        return $"{bytes:0.#} {units[unit]}";
    }

    // Guards rather than the tidier relational patterns (`< 1 => ...`): inside @code, a line
    // starting with '<' is read as an HTML tag by the Razor parser shipped in some .NET SDK
    // feature bands, including the one Fedora packages, and the component fails to compile there.
    private static string FormatDays(double days) => days switch
    {
        _ when days < 1 => $"{days * 24:0.#} hours",
        _ when days < 10 => $"{days:0.#} days",
        _ when days < 730 => $"{days:0} days",
        _ => $"{days / 365.25:0.#} years",
    };

    // Cancelled rather than disposed, because a read can land after the page has gone; see PageReads.
    // Also what stops the overlay's countdown, if one is running.
    public void Dispose() => _cts.Cancel();

    /// <summary>What the overlay is open for, and for a restore, which step of it.</summary>
    private enum Confirming
    {
        Nothing,
        Download,

        /// <summary>The current password, which a restore asks for before anything else.</summary>
        RestorePassword,

        /// <summary>The password given, and the file still to choose.</summary>
        RestoreFile,

        /// <summary>The file chosen, and the restore to confirm.</summary>
        Restore,

        /// <summary>The restore confirmed, and what came of it: done, refused or failed.</summary>
        Restored,

        /// <summary>The snapshot for a download being written, after the password if one is set.</summary>
        Preparing,
    }

    private sealed class DatabaseForm
    {
        [Range(0, SizeUpperBoundMb, ErrorMessage = "Enter a size between 0 and 1,000,000 MB.")]
        public int MaxDatabaseSizeMb { get; set; }
    }

    private sealed class PingerForm
    {
        [Range(1, IntervalUpperBoundSeconds, ErrorMessage = "Enter an interval between 1 and 86400 seconds.")]
        public int IntervalSeconds { get; set; }

        [Range(1, TimeoutUpperBoundSeconds, ErrorMessage = "Enter a timeout between 1 and 60 seconds.")]
        public int TimeoutSeconds { get; set; }

        [Range(1, TimeoutUpperBoundSeconds, ErrorMessage = "Enter a resolve timeout between 1 and 60 seconds.")]
        public int ResolveTimeoutSeconds { get; set; }

        [Range(0, RetryAttemptsUpperBound, ErrorMessage = "Enter between 0 and 1000 attempts.")]
        public int RetryAttempts { get; set; }
    }
}
