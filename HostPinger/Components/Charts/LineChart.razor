@using System.Globalization
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="chart-card" @ref="_cardRef">
    <div class="chart-wrap" @ref="_plotRef">
        @if (!HasAnyData)
        {
            <div class="chart-empty">No ping data in this window yet.</div>
        }
        else
        {
            <svg @ref="_svgRef" width="@F(_effectiveWidth)" height="@F(_effectiveHeight)" viewBox="0 0 @F(_effectiveWidth) @F(_effectiveHeight)" role="img"
                 aria-label="Ping round-trip time over time"
                 @onpointerdown="OnPointerDownAsync" @onpointermove="OnPointerMove"
                 @onpointerup="OnPointerUpAsync" @onpointercancel="CancelDrag"
                 @onmouseleave="ClearHover">
                @foreach (var tick in _yTicks)
                {
                    var y = YToPixel(tick);
                    <line x1="@F(PlotLeft)" y1="@F(y)" x2="@F(PlotLeft + _plotWidth)" y2="@F(y)" class="grid" />
                    @SvgText(PlotLeft - 8, y, "end", true, "tick-label", 11, YLabel(tick))
                }
                @foreach (var tick in _xTicks)
                {
                    var x = XToPixel(tick);
                    <line x1="@F(x)" y1="@F(PlotTop + _plotHeight)" x2="@F(x)" y2="@F(PlotTop + _plotHeight + 4)" class="axis" />
                    @SvgText(x, PlotTop + _plotHeight + 17, "middle", false, "tick-label", 11, TimeLabel(tick))
                }
                <line x1="@F(PlotLeft)" y1="@F(PlotTop + _plotHeight)" x2="@F(PlotLeft + _plotWidth)" y2="@F(PlotTop + _plotHeight)" class="axis" />

                @foreach (var item in _rendered)
                {
                    @foreach (var segment in item.Geometry.Segments)
                    {
                        @*
                            A series colour is a var() naming a palette slot, so it goes in a style
                            attribute rather than an SVG presentation attribute — var() is only
                            reliably resolved in the former.
                        *@
                        @if (segment.Count == 1)
                        {
                            <circle cx="@F(segment[0].X + PlotLeft)" cy="@F(segment[0].Y + PlotTop)" r="2.5" style="fill:@item.Series.Color" />
                        }
                        else
                        {
                            <polyline points="@PointsAttribute(segment)" fill="none" style="stroke:@item.Series.Color"
                                      stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
                        }
                    }
                    @foreach (var marker in item.Geometry.DownMarkers)
                    {
                        <path d="@DownMarkerPath(marker, item.Lane)" style="stroke:@item.Series.Color" stroke-width="1.5" fill="none" />
                    }
                    @if (_directLabels.TryGetValue(item.Series.Label, out var label))
                    {
                        <circle cx="@F(label.CircleX)" cy="@F(label.Y)" r="4" style="fill:@item.Series.Color" />
                        @SvgText(label.TextX, label.Y, "start", true, "series-label", 12, item.Series.Label)
                    }
                }
                @if (_hoverX is double crosshairX)
                {
                    <line x1="@F(crosshairX)" y1="@F(PlotTop)" x2="@F(crosshairX)" y2="@F(PlotTop + _plotHeight)" class="crosshair" />
                }
                @if (SelectionBand is (double bandLeft, double bandWidth))
                {
                    <rect x="@F(bandLeft)" y="@F(PlotTop)" width="@F(bandWidth)" height="@F(_plotHeight)" class="selection" />
                    <line x1="@F(bandLeft)" y1="@F(PlotTop)" x2="@F(bandLeft)" y2="@F(PlotTop + _plotHeight)" class="selection-edge" />
                    <line x1="@F(bandLeft + bandWidth)" y1="@F(PlotTop)" x2="@F(bandLeft + bandWidth)" y2="@F(PlotTop + _plotHeight)" class="selection-edge" />
                    @SvgText(bandLeft + bandWidth / 2, PlotTop + 12, "middle", true, "selection-label", 11, SelectionDurationText)
                }
            </svg>
            @if (_hoverX is double tooltipX && _hoverRows.Count > 0)
            {
                <div class="chart-tooltip" style="left: @(F(TooltipLeft(tooltipX)))px; top: 12px;">
                    <div class="tooltip-time">@_hoverTime</div>
                    @foreach (var row in _hoverRows)
                    {
                        <div class="tooltip-row">
                            <span class="swatch" style="background:@row.Color"></span>
                            <span class="name">@row.Label</span>
                            <span class="val">@row.Value</span>
                        </div>
                    }
                </div>
            }
        }
    </div>
    @if (Series.Count >= 2)
    {
        <div class="legend">
            @foreach (var series in Series)
            {
                <button type="button" class="legend-item @(_hidden.Contains(series.Label) ? "is-hidden" : "")"
                        @onclick="() => ToggleSeries(series.Label)">
                    <span class="swatch" style="background:@series.Color"></span>
                    <span class="name">@series.Label</span>
                    <span class="val">@LatestText(series)</span>
                </button>
            }
        </div>
    }
    else if (Series.Count == 1)
    {
        <div class="legend">
            <div class="legend-item static">
                <span class="swatch" style="background:@Series[0].Color"></span>
                <span class="name">@Series[0].Label</span>
                <span class="val">@LatestText(Series[0])</span>
            </div>
        </div>
    }
</div>

@code {
    private const double PlotLeft = 56;
    private const double PlotTop = 16;
    private const double BottomPad = 34;
    private const double HoverRadiusPx = 24;

    /// <summary>A drag has to cover this much before it is a selection rather than a stray click.</summary>
    private const double MinimumSelectionPx = 8;

    /// <summary>How close to the right-hand edge a drag has to end to count as ending at "now".</summary>
    private const double EndEdgeTolerancePx = 6;

    [Parameter, EditorRequired] public IReadOnlyList<ChartSeriesData> Series { get; set; } = [];
    [Parameter] public DateTime RangeStartUtc { get; set; }
    [Parameter] public DateTime RangeEndUtc { get; set; }
    [Parameter] public double Width { get; set; } = 920;
    [Parameter] public double Height { get; set; } = 340;
    [Parameter] public TimeSpan UpdateInterval { get; set; }

    /// <summary>
    /// The width of one bucket the samples in <see cref="Series"/> were reduced into, or
    /// <see cref="TimeSpan.Zero"/> when they are raw pings. Sets the scale at which a hole in a
    /// downsampled series is real: bucketed points sit one bucket apart — the one still filling can
    /// sit closer, never further — so a wider step than that is a bucket that had nothing to average.
    /// </summary>
    [Parameter] public TimeSpan BucketDuration { get; set; }

    /// <summary>
    /// Called with the plot area's width in <em>device</em> pixels (its CSS width scaled by
    /// devicePixelRatio) once it has been measured, and again whenever it changes, so the caller can
    /// match how densely it samples to the resolution actually available. The chart's own geometry
    /// stays in CSS pixels; only the sampling budget cares about the physical device.
    /// <para>
    /// A plain delegate rather than an <see cref="EventCallback"/>, and it fires mid-render: the
    /// handler is expected to record the width for later, not to act on it. An EventCallback would
    /// re-render the caller on every pixel of a window drag.
    /// </para>
    /// </summary>
    [Parameter] public Action<double>? PlotDeviceWidthChanged { get; set; }

    /// <summary>
    /// Raised when a drag across the plot has picked out a range of time. The chart only reports
    /// the selection; what to do with it — and whether the range it is currently being given is
    /// still moving with the clock — belongs to the caller.
    /// </summary>
    [Parameter] public EventCallback<ChartSelection> RangeSelected { get; set; }

    private ElementReference _cardRef;
    private ElementReference _plotRef;
    private ElementReference _svgRef;
    private IJSObjectReference? _module;
    private IJSObjectReference? _observer;
    private DotNetObjectReference<LineChart>? _selfRef;
    private double _effectiveWidth;
    private double _effectiveHeight;
    private double _rightPad;
    private double _plotWidth;
    private double _plotHeight;
    private bool _sizeMeasured;
    private double _pixelRatio = 1;
    private double _reportedDeviceWidth;
    private double _scaleMax = 1;
    private IReadOnlyList<double> _yTicks = [];
    private IReadOnlyList<DateTime> _xTicks = [];
    private List<RenderedSeries> _rendered = [];
    private Dictionary<string, DirectLabel> _directLabels = new();
    private readonly HashSet<string> _hidden = [];
    private double? _hoverX;
    private string _hoverTime = string.Empty;
    private List<HoverRow> _hoverRows = [];
    private double? _dragStartX;
    private double? _dragCurrentX;

    private sealed record RenderedSeries(ChartSeriesData Series, ChartSeriesGeometry Geometry, int Lane);
    private sealed record DirectLabel(double CircleX, double TextX, double Y);
    private sealed record HoverRow(string Label, string Color, string Value);

    private bool HasAnyData => Series.Any(s => s.Samples.Count > 0);

    protected override void OnParametersSet()
    {
        if (_effectiveWidth <= 0)
        {
            _effectiveWidth = Width;
        }

        if (_effectiveHeight <= 0)
        {
            _effectiveHeight = Height;
        }

        Recompute();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Charts/LineChart.razor.js");
        _selfRef = DotNetObjectReference.Create(this);
        _observer = await _module.InvokeAsync<IJSObjectReference>("observeSize", _cardRef, _plotRef, _selfRef);
    }

    [JSInvokable]
    public async Task SetSize(double width, double height, double pixelRatio)
    {
        if (width <= 0 || height <= 0 || pixelRatio <= 0
            || (Math.Abs(width - _effectiveWidth) < 1 && Math.Abs(height - _effectiveHeight) < 1
                && pixelRatio == _pixelRatio))
        {
            return;
        }

        await InvokeAsync(() =>
        {
            _effectiveWidth = width;
            _effectiveHeight = height;
            _pixelRatio = pixelRatio;
            _sizeMeasured = true;
            Recompute();
            StateHasChanged();
        });
    }

    private void Recompute()
    {
        var visible = Series.Where(s => !_hidden.Contains(s.Label)).ToList();
        var showDirectLabels = Series.Count is >= 2 and <= 4;
        _rightPad = showDirectLabels ? 120 : 20;
        _plotWidth = Math.Max(50, _effectiveWidth - PlotLeft - _rightPad);
        _plotHeight = Math.Max(50, _effectiveHeight - PlotTop - BottomPad);

        // The plot width is only known once the browser has laid the chart out, so it is pushed to
        // the caller from here rather than taken as a parameter. Nothing before the first
        // measurement is worth reporting: it would only describe the fallback size.
        var deviceWidth = _plotWidth * _pixelRatio;
        if (_sizeMeasured && Math.Abs(deviceWidth - _reportedDeviceWidth) >= 1)
        {
            _reportedDeviceWidth = deviceWidth;
            PlotDeviceWidthChanged?.Invoke(deviceWidth);
        }

        double maxValue = 0;
        foreach (var series in visible)
        {
            foreach (var sample in series.Samples)
            {
                if (sample.TimestampUtc >= RangeStartUtc && sample.TimestampUtc <= RangeEndUtc
                    && sample.RoundtripMs is int value && value > maxValue)
                {
                    maxValue = value;
                }
            }
        }

        _yTicks = ChartMath.NiceTicks(maxValue, 6);
        _scaleMax = _yTicks[^1];
        _xTicks = ChartMath.TimeTicks(RangeStartUtc, RangeEndUtc, 7);
        // A break in the line has two scales and the wider one wins, because which applies depends
        // on how the samples arrived. Sparser than the buckets, and they are passed through raw, so
        // the ping cadence sets it; denser, and they are bucket midpoints exactly one bucket apart,
        // where 1.5 buckets separates "the next bucket" from "a bucket with no data in it".
        var intervalGap = UpdateInterval > TimeSpan.Zero ? UpdateInterval * 10 : TimeSpan.Zero;
        var bucketGap = BucketDuration > TimeSpan.Zero ? BucketDuration * 1.5 : TimeSpan.Zero;
        var gap = intervalGap > bucketGap ? intervalGap : bucketGap;
        TimeSpan? maxGap = gap > TimeSpan.Zero ? gap : null;
        _rendered = visible
            .Select((s, i) => new RenderedSeries(
                s,
                ChartMath.BuildGeometry(s.Samples, RangeStartUtc, RangeEndUtc, _scaleMax, _plotWidth, _plotHeight, maxGap),
                i))
            .ToList();

        _directLabels = new();
        if (showDirectLabels)
        {
            var labeled = _rendered
                .Where(r => r.Geometry.Segments.Count > 0)
                .Select(r => (r.Series.Label, LastPoint: r.Geometry.Segments[^1][^1]))
                .ToList();
            var positions = ChartMath.SpreadLabels(
                labeled.Select(l => l.LastPoint.Y + PlotTop).ToList(),
                16, PlotTop + 6, PlotTop + _plotHeight);
            for (var i = 0; i < labeled.Count; i++)
            {
                _directLabels[labeled[i].Label] = new DirectLabel(
                    PlotLeft + _plotWidth + 10, PlotLeft + _plotWidth + 18, positions[i]);
            }
        }
    }

    private void ToggleSeries(string label)
    {
        if (!_hidden.Remove(label))
        {
            _hidden.Add(label);
        }

        ClearHover();
        Recompute();
    }

    /// <summary>The band being dragged out, in chart pixels, or null when nothing is being dragged.</summary>
    private (double Left, double Width)? SelectionBand
    {
        get
        {
            if (_dragStartX is not double startX || _dragCurrentX is not double currentX)
            {
                return null;
            }

            var width = Math.Abs(currentX - startX);
            return width < 1 ? null : (Math.Min(startX, currentX), width);
        }
    }

    /// <summary>How much time the band being dragged out covers, for the label inside it.</summary>
    private string SelectionDurationText
    {
        get
        {
            if (SelectionBand is not (_, double width) || _plotWidth <= 0)
            {
                return string.Empty;
            }

            return Downtime.FormatDuration((RangeEndUtc - RangeStartUtc) * (width / _plotWidth));
        }
    }

    // Dragging across the plot picks a range of time out of it. These are pointer events rather
    // than mouse events so that the pointer can be captured for the duration of the drag: a
    // selection that runs off the side of the plot, or out of the window altogether, still ends
    // where the button comes up instead of leaving a band stranded on screen.
    private async Task OnPointerDownAsync(PointerEventArgs e)
    {
        // Primary button only, and never touch: on a touch screen this same gesture scrolls the
        // page, and a chart that swallowed it would strand the reader on it.
        if (e.Button != 0 || e.PointerType == "touch" || _plotWidth <= 0)
        {
            return;
        }

        var x = e.OffsetX;
        if (x < PlotLeft || x > PlotLeft + _plotWidth)
        {
            return;
        }

        _dragStartX = x;
        _dragCurrentX = x;
        ClearHover();

        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync("capturePointer", _svgRef, e.PointerId);
        }
        catch (JSException)
        {
            // The pointer was already released by the time the call landed. The drag still ends
            // itself on the next move that arrives with no button held.
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private void OnPointerMove(PointerEventArgs e)
    {
        if (_dragStartX is null)
        {
            UpdateHover(e);
            return;
        }

        // Moving with no button held means the release happened somewhere this element never heard
        // about — the pointer left before the capture took effect. Drop the drag rather than
        // leaving a band following the pointer around.
        if (e.Buttons == 0)
        {
            CancelDrag();
            return;
        }

        _dragCurrentX = Math.Clamp(e.OffsetX, PlotLeft, PlotLeft + _plotWidth);
    }

    private async Task OnPointerUpAsync(PointerEventArgs e)
    {
        if (_dragStartX is not double startX)
        {
            return;
        }

        // With the pointer captured this can land well outside the plot, which is the point: a drag
        // aimed past the right-hand edge means "up to the end", so it clamps there rather than
        // being thrown away.
        var endX = Math.Clamp(e.OffsetX, PlotLeft, PlotLeft + _plotWidth);
        CancelDrag();

        var selection = ChartMath.SelectionFromPixels(
            startX - PlotLeft,
            endX - PlotLeft,
            _plotWidth,
            RangeStartUtc,
            RangeEndUtc,
            MinimumSelectionPx,
            EndEdgeTolerancePx);
        if (selection is not null)
        {
            await RangeSelected.InvokeAsync(selection);
        }
    }

    private void CancelDrag()
    {
        _dragStartX = null;
        _dragCurrentX = null;
    }

    private void UpdateHover(MouseEventArgs e)
    {
        var x = e.OffsetX;
        if (x < PlotLeft || x > PlotLeft + _plotWidth || _rendered.Count == 0)
        {
            ClearHover();
            return;
        }

        var rangeTicks = (RangeEndUtc - RangeStartUtc).Ticks;
        var targetUtc = RangeStartUtc + TimeSpan.FromTicks((long)((x - PlotLeft) / _plotWidth * rangeTicks));

        var rows = new List<HoverRow>();
        var bestDistance = double.MaxValue;
        var bestTime = default(DateTime);
        foreach (var item in _rendered)
        {
            var index = ChartMath.NearestSampleIndex(item.Series.Samples, targetUtc);
            if (index < 0)
            {
                continue;
            }

            var sample = item.Series.Samples[index];
            if (sample.TimestampUtc < RangeStartUtc || sample.TimestampUtc > RangeEndUtc)
            {
                continue;
            }

            var sampleX = XToPixel(sample.TimestampUtc);
            var distance = Math.Abs(sampleX - x);
            if (distance > HoverRadiusPx)
            {
                continue;
            }

            rows.Add(new HoverRow(
                item.Series.Label,
                item.Series.Color,
                sample.RoundtripMs is int value ? $"{value} ms" : "down"));
            if (distance < bestDistance)
            {
                bestDistance = distance;
                bestTime = sample.TimestampUtc;
            }
        }

        if (rows.Count == 0)
        {
            ClearHover();
            return;
        }

        _hoverX = XToPixel(bestTime);
        _hoverTime = bestTime.ToLocalTime().ToString("HH:mm:ss");
        _hoverRows = rows;
    }

    private void ClearHover()
    {
        _hoverX = null;
        _hoverTime = string.Empty;
        _hoverRows = [];
    }

    private double XToPixel(DateTime timestampUtc) =>
        PlotLeft + (timestampUtc - RangeStartUtc).Ticks / (double)(RangeEndUtc - RangeStartUtc).Ticks * _plotWidth;

    private double YToPixel(double value) =>
        PlotTop + _plotHeight - value / _scaleMax * _plotHeight;

    private double TooltipLeft(double hoverX) =>
        hoverX > PlotLeft + _plotWidth * 0.6 ? hoverX - 195 : hoverX + 14;

    private string PointsAttribute(IReadOnlyList<ChartPoint> segment) =>
        string.Join(' ', segment.Select(p => $"{F(p.X + PlotLeft)},{F(p.Y + PlotTop)}"));

    private string DownMarkerPath(ChartPoint marker, int lane)
    {
        var cx = marker.X + PlotLeft;
        var cy = PlotTop + _plotHeight - 5 - lane * 8;
        return $"M {F(cx - 3)} {F(cy - 3)} L {F(cx + 3)} {F(cy + 3)} M {F(cx - 3)} {F(cy + 3)} L {F(cx + 3)} {F(cy - 3)}";
    }

    private string YLabel(double tick)
    {
        var text = tick.ToString(tick % 1 == 0 ? "0" : "0.##", CultureInfo.InvariantCulture);
        return tick == _yTicks[^1] ? $"{text} ms" : text;
    }

    private string TimeLabel(DateTime tickUtc)
    {
        var range = RangeEndUtc - RangeStartUtc;
        var format = range <= TimeSpan.FromDays(1) ? "HH:mm"
            : range <= TimeSpan.FromDays(7) ? "ddd HH:mm"
            : "MM-dd";
        return tickUtc.ToLocalTime().ToString(format);
    }

    private static string LatestText(ChartSeriesData series)
    {
        if (series.Samples.Count == 0)
        {
            return "no data";
        }

        var last = series.Samples[^1];
        return last.RoundtripMs is int value ? $"{value} ms" : "down";
    }

    private static string F(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_observer is not null)
            {
                await _observer.InvokeVoidAsync("dispose");
                await _observer.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already gone; nothing to clean up on the client.
        }

        _selfRef?.Dispose();
    }

    // Razor reserves the <text> tag, so SVG text elements are emitted as raw markup. The fill
    // comes from a class rather than an attribute so that it can follow the theme: the markup
    // carries no scope attribute of its own, but the stylesheet reaches it through the wrapper
    // with ::deep.
    private static MarkupString SvgText(double x, double y, string anchor, bool middleBaseline, string cssClass, int fontSize, string content)
    {
        var baseline = middleBaseline ? " dominant-baseline=\"middle\"" : string.Empty;
        return new MarkupString(
            $"<text x=\"{F(x)}\" y=\"{F(y)}\" text-anchor=\"{anchor}\"{baseline} class=\"{cssClass}\" " +
            $"font-size=\"{fontSize}\" style=\"font-variant-numeric: tabular-nums\">" +
            $"{System.Net.WebUtility.HtmlEncode(content)}</text>");
    }
}
