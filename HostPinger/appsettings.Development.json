{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Puts back the executed-command logging appsettings.json turns off. What is noise in a
      // service that runs for months is the point of a console run: the SQL a page or a ping
      // round actually emits is visible as it happens.
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "Pinger": {
    "DatabasePath": "Data/hostpinger-dev.db",
    "UserSettingsPath": "Data/usersettings.json"
  }
}
