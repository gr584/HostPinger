<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <!-- The package version is bound to the executable's file version, which GitVersion stamps from
       the git history. Tagging a release therefore sets the installer version too; MSI keeps only
       the first three fields, so any prerelease label GitVersion computes is dropped here. -->
  <Package Name="HostPinger"
           Manufacturer="Gleb Romanov"
           Version="!(bind.FileVersion.HostPingerExe)"
           UpgradeCode="B7B14BB1-86DC-496A-B313-C20758C8CF60"
           Scope="perMachine"
           Compressed="yes">

    <!-- MSI keeps only three version fields, so every commit between two tags builds the same
         ProductVersion. AllowSameVersionUpgrades lets such a build replace the installed one
         instead of being treated as a reinstall. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- The application is published framework-dependent, so the ASP.NET Core runtime has to be on
         the machine already; this is what the spec file states as Requires: aspnetcore-runtime-10.0.
         Without the check the install runs to the point of starting the service, fails there, and
         rolls back with a message that says nothing about a missing runtime.

         "Installed OR" so that uninstalling or repairing still works on a machine the runtime has
         since been removed from. -->
    <Launch Condition="Installed OR ASPNETCORERUNTIME"
            Message="[ProductName] requires the ASP.NET Core Runtime 10.0 (x64), which is not installed on this machine. Install it from https://dotnet.microsoft.com/download/dotnet/10.0 and run this installer again." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="HostPinger" />
    </StandardDirectory>

    <Feature Id="Main" Title="HostPinger">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="HostPingerService" />
    </Feature>

    <!--
      Detects the runtime the launch condition above insists on.

      Not a registry search for the framework itself. .NET does list the installed shared
      frameworks under Setup\InstalledVersions\x64\sharedfx, but each one appears as a value named
      for an exact patch version, so nothing there answers "is any 10.0.x present". The file system
      does: the framework lives in a version-named directory and the assembly inside carries a file
      version in the same band, 10.0.10 shipping 10.0.1026.32716. Hence the version range, which
      also keeps an 8.0 runtime beside it from satisfying the check.

      Rooted at the registered install path rather than a hard-coded Program Files one, so a dotnet
      installed elsewhere is still found. That registry value has to be read as a directory rather
      than a raw value for the search below to hang off it, and from the 64-bit view, which is
      where the x64 shared host records itself.

      Depth crosses the version-named directory. The file search must stay anonymous for it to
      work: an Id on FileSearch makes WiX emit the depth against the directory locator instead of
      the file one, and the search then only ever looks in Microsoft.AspNetCore.App itself.
    -->
    <Property Id="ASPNETCORERUNTIME">
      <RegistrySearch Id="DotnetRoot"
                      Root="HKLM"
                      Key="SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedhost"
                      Name="Path"
                      Type="directory"
                      Bitness="always64">
        <DirectorySearch Id="AspNetCoreSharedFramework" Path="shared\Microsoft.AspNetCore.App" Depth="1">
          <FileSearch Name="Microsoft.AspNetCore.dll" MinVersion="10.0.0.0" MaxVersion="11.0.0.0" />
        </DirectorySearch>
      </RegistrySearch>
    </Property>

  </Package>

  <Fragment>

    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <!-- The executable is packaged separately below because it carries the service entries;
           the development-only settings file has no business on an installed machine. -->
      <Files Include="$(PublishDir)\**">
        <Exclude Files="$(PublishDir)\HostPinger.exe" />
        <Exclude Files="$(PublishDir)\appsettings.Development.json" />
      </Files>
    </ComponentGroup>

    <Component Id="HostPingerService" Directory="INSTALLFOLDER">
      <File Id="HostPingerExe" Source="$(PublishDir)\HostPinger.exe" KeyPath="yes" />

      <!-- Account is left unset, which means LocalSystem. The service writes its database and
           user settings under %ProgramData%\HostPinger, created on first start. -->
      <ServiceInstall Id="HostPingerServiceInstall"
                      Name="HostPinger"
                      DisplayName="HostPinger"
                      Description="Pings configured hosts on a schedule and serves the HostPinger web UI."
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Vital="yes" />

      <ServiceControl Id="HostPingerServiceControl"
                      Name="HostPinger"
                      Start="install"
                      Stop="both"
                      Remove="uninstall"
                      Wait="yes" />

      <!--
        The service control manager hands this multi-string to the process as environment
        variables, which is how an ASP.NET Core service is configured on Windows. It is the
        counterpart of /etc/sysconfig/hostpinger on the Linux side, down to the variable name, and
        an administrator edits it the same way — change the value, then Restart-Service HostPinger.
        Unlike the sysconfig file, which the RPM marks noreplace, an upgrade rewrites it.

        Without it Kestrel binds its own default of localhost:5000, which leaves a machine-wide
        service reachable only from the machine running it. ASPNETCORE_HTTP_PORTS names a port
        rather than an address and so listens on every interface, matching what the RPM does on
        8080.

        Written before InstallServices creates the key, which is fine: the service is not in the
        control manager's database yet, so CreateService opens this key rather than refusing the
        name, and the values it writes join the one already there.

        Binding the port is only half of reaching the UI; the firewall rule below is the other half.
      -->
      <RegistryValue Root="HKLM"
                     Key="SYSTEM\CurrentControlSet\Services\HostPinger"
                     Name="Environment"
                     Type="multiString"
                     Action="write"
                     Value="ASPNETCORE_HTTP_PORTS=5000" />

      <!--
        Inbound is blocked by default, so binding every interface above achieves nothing on its own
        — the service would answer only the machine it runs on, which is what listening on
        localhost would already have done. This is where the Windows packaging departs from the
        RPM, which leaves firewalld alone and tells the administrator to run firewall-cmd: on
        Fedora that is the convention, and on Windows an installer that leaves the port shut is
        simply an installer that does not work.

        Scoped to this executable as well as the port, so opening 5000 opens it for HostPinger and
        nothing else that might later listen there.

        Domain and private only. The UI has no authentication of any kind — anyone who reaches it
        can add and delete monitored hosts along with their history — so a public network, which is
        Windows' name for the untrusted ones, is not somewhere to answer on. A machine that genuinely
        needs it can add that profile by hand.

        Two elements because @Profile takes one value and each becomes its own rule; they share a
        name, which is how Windows itself lists a per-profile pair.

        IgnoreFailure because the rule is a convenience and the service is the product: on a machine
        running a third-party firewall, or with the Windows Firewall service disabled, adding the
        rule fails, and rolling the whole install back over that would be a poor trade. The README
        gives the New-NetFirewallRule command for putting it back by hand.
      -->
      <fw:FirewallException Id="WebUiDomain"
                            Name="HostPinger web UI"
                            Description="Inbound access to the HostPinger web UI."
                            File="HostPingerExe"
                            Port="5000"
                            Protocol="tcp"
                            Profile="domain"
                            IgnoreFailure="yes" />

      <fw:FirewallException Id="WebUiPrivate"
                            Name="HostPinger web UI"
                            Description="Inbound access to the HostPinger web UI."
                            File="HostPingerExe"
                            Port="5000"
                            Protocol="tcp"
                            Profile="private"
                            IgnoreFailure="yes" />
    </Component>

  </Fragment>

</Wix>
