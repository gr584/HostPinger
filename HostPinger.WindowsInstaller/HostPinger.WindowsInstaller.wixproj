<!-- WiX 6 is the newest release that builds without an Open Source Maintenance Fee EULA id;
     v7 fails the build with WIX7015 unless one is supplied. -->
<Project Sdk="WixToolset.Sdk/6.0.2">

  <!-- Package.wxs opens the web UI's port in Windows Firewall, which needs this extension; the
       rule is authored declaratively rather than by shelling out to netsh from a custom action. -->
  <ItemGroup>
    <PackageReference Include="WixToolset.Firewall.wixext" Version="6.0.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputName>HostPinger</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- ICE60: e_sqlite3.dll carries a version resource but no language resource, which is
         expected of a native library and harmless here.
         ICE61: fires because AllowSameVersionUpgrades lets the upgrade range include the current
         version, which is deliberate. -->
    <SuppressIces>ICE60;ICE61</SuppressIces>
  </PropertyGroup>

  <!--
    The MSI always packages a Release publish of the application, whatever configuration this
    project itself is built in. The solution excludes this project from Debug builds so the extra
    publish only runs when an installer is actually wanted.

    Framework-dependent, matching the RPM: the ASP.NET Core runtime comes from the machine and is
    serviced there rather than being frozen into the installer, so a runtime security fix does not
    need a new HostPinger release to reach an installed copy. Package.wxs refuses to install
    without it, which is the MSI's equivalent of the spec file's Requires:.

    RID-specific all the same, so the publish carries a Windows launcher and the win-x64 native
    libraries — the executable is what the installer binds its version to and what the service
    entry points at.
  -->
  <PropertyGroup>
    <AppProject>$(MSBuildThisFileDirectory)..\HostPinger\HostPinger.csproj</AppProject>
    <AppRuntimeIdentifier>win-x64</AppRuntimeIdentifier>
    <!-- No trailing slash: a path ending in "\" would escape the closing quote in Exec. -->
    <AppPublishDir>$(MSBuildProjectDirectory)\obj\publish\$(AppRuntimeIdentifier)</AppPublishDir>
    <DefineConstants>$(DefineConstants);PublishDir=$(AppPublishDir)</DefineConstants>
  </PropertyGroup>

  <!-- CoreCompile is where WiX reads the files it packages; the SDK defines no BeforeBuild hook. -->
  <Target Name="PublishApplication" BeforeTargets="CoreCompile">
    <!-- dotnet publish does not clear its output directory, so drop files left by an earlier
         publish rather than shipping them in the MSI. -->
    <RemoveDir Directories="$(AppPublishDir)" />
    <Exec Command="dotnet publish &quot;$(AppProject)&quot; --configuration Release --runtime $(AppRuntimeIdentifier) --no-self-contained --output &quot;$(AppPublishDir)&quot;" />
  </Target>

</Project>
