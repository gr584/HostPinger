<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the tests assert on the SQL shape of internal queries, and take one turn of
         HostSummaryCache's loop at a time (PollAsync) instead of racing its once-a-second poll.
         Everything that takes a context or its factory and is not a service's constructor is
         internal, so that the web project, which may not touch the database, cannot hand one in
         without a compile error; the tests and the benchmarks, which time those very calls, are
         the projects that may. -->
    <InternalsVisibleTo Include="HostPinger.Test" />
    <InternalsVisibleTo Include="HostPinger.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

</Project>
